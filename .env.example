# ── DEFENDIA — Ortam Değişkenleri ──
# Bu dosyayı ".env" olarak kopyalayın ve kendi değerlerinizle doldurun.
# .env dosyası .gitignore ile korunur; gerçek değerleri asla commit etmeyin.

# Uygulama portu
PORT=3000

# Oturum imzalama anahtarı (uzun ve rastgele bir değer üretin)
SESSION_SECRET=degistirin-uzun-rastgele-bir-deger

# ── Proxmox VE Bağlantısı ──
# Proxmox node adı (ör. pve)
PVE_NODE=pve
# Proxmox sunucu IP adresi (ör. 10.0.0.10)
PVE_IP=PROXMOX_SUNUCU_IP
# Proxmox API Token — format: PVEAPIToken=KULLANICI@pam!TOKENADI=xxxxxxxx-xxxx-...
PVE_API_TOKEN=PVEAPIToken=user@pam!token=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── HackerBox (kişisel Linux ortamı) ──
# Klonlanacak şablon VM'in ID'si
HACKERBOX_TEMPLATE_VMID=110
# Tarayıcı içi noVNC portu
HACKERBOX_VNC_PORT=8080
# noVNC erişim şifresi
HACKERBOX_VNC_PASSWORD=degistirin
