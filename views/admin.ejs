<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <link rel="icon" type="image/png" href="/favicon.png">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Defendia Network Defense | Admin Panel</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/animations.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/notifications.css">
  <link rel="stylesheet" href="/css/admin.css">
  <script>window.__searchData = <%- JSON.stringify(searchData) %>;</script>
</head>
<body>

<div id="toast-container"></div>

<div class="dash-shell page-enter">

  <%- include('partials/sidebar-only') %>

  <div class="dash-main">
    <!-- Topbar -->
    <div class="dash-topbar">
      <div class="dash-topbar-left">
        <span class="dash-status-tag">ADMIN // <span id="adminPageTitle">SİSTEM İSTATİSTİKLERİ</span></span>
      </div>
      <div class="dash-topbar-right">
        <!-- Bildirim ikonu -->
        <div class="dash-icon-btn" id="notifBellBtn" title="Bildirimler" style="position:relative;">
          <span class="material-icons">notifications</span>
          <span id="notifBadge" style="display:none;position:absolute;top:4px;right:4px;width:8px;height:8px;background:#ef4444;border-radius:50%;"></span>
        </div>
      </div>
    </div>

    <!-- Bildirim Dropdown -->
    <div id="notifDropdown" style="display:none;position:fixed;top:56px;right:16px;width:340px;background:rgba(13,17,23,0.97);border:1px solid rgba(255,255,255,0.08);border-radius:12px;z-index:9000;backdrop-filter:blur(16px);box-shadow:0 8px 32px rgba(0,0,0,0.5);">
      <div style="padding:14px 16px;border-bottom:1px solid rgba(255,255,255,0.06);display:flex;justify-content:space-between;align-items:center;">
        <span style="font-size:11px;font-weight:700;color:#94a3b8;letter-spacing:2px;font-family:'JetBrains Mono',monospace;">BİLDİRİMLER</span>
        <div style="display:flex;gap:8px;">
          <button onclick="markAllAsRead()" style="background:none;border:none;color:#38bdf8;font-size:10px;cursor:pointer;font-family:'JetBrains Mono',monospace;">TÜMÜNÜ OKU</button>
          <button onclick="clearAllNotifications()" style="background:none;border:none;color:#ef4444;font-size:10px;cursor:pointer;font-family:'JetBrains Mono',monospace;">TEMİZLE</button>
        </div>
      </div>
      <div id="notifList" style="max-height:320px;overflow-y:auto;padding:8px 0;"></div>
    </div>

    <!-- Admin İçerik Alanı -->
    <div class="dash-content-area">
      <!-- Admin Sol Menü -->
      <div class="admin-nav-panel">
        <button id="btn-viewDashboard" class="admin-nav-btn active" onclick="switchMenu('viewDashboard')">
          <span class="material-icons">bar_chart</span>
          <span>Sistem İstatistikleri</span>
        </button>
        <button id="btn-viewUsers" class="admin-nav-btn" onclick="switchMenu('viewUsers')">
          <span class="material-icons">group</span>
          <span>Operatör Yönetimi</span>
        </button>
        <button id="btn-viewLabs" class="admin-nav-btn" onclick="switchMenu('viewLabs')">
          <span class="material-icons">dns</span>
          <span>Laboratuvar Makineleri</span>
        </button>
        <button id="btn-viewCtf" class="admin-nav-btn" onclick="switchMenu('viewCtf')">
          <span class="material-icons">security</span>
          <span>CTF Görevleri</span>
        </button>
        <button id="btn-viewScenarios" class="admin-nav-btn" onclick="switchMenu('viewScenarios')">
          <span class="material-icons">map</span>
          <span>Operasyon Senaryoları</span>
        </button>
        <button id="btn-viewSystem" class="admin-nav-btn" onclick="switchMenu('viewSystem')">
          <span class="material-icons">campaign</span>
          <span>Duyuru & Bildirimler</span>
        </button>
        <button id="btn-viewTeams" class="admin-nav-btn" onclick="switchMenu('viewTeams')">
          <span class="material-icons">groups</span>
          <span>Takım Yönetimi</span>
        </button>
        <button id="btn-viewFirstBloods" class="admin-nav-btn" onclick="switchMenu('viewFirstBloods')">
          <span class="material-icons" style="color:#ef4444;">bloodtype</span>
          <span>İlk Kan Kayıtları</span>
        </button>
        <button id="btn-viewBadges" class="admin-nav-btn" onclick="switchMenu('viewBadges')">
          <span class="material-icons" style="color:#fbbf24;">military_tech</span>
          <span>Rozet Yönetimi</span>
        </button>
        <button id="btn-viewBans" class="admin-nav-btn" onclick="switchMenu('viewBans')">
          <span class="material-icons" style="color:#ef4444;">block</span>
          <span>Yasaklama Yönetimi</span>
        </button>
        <button id="btn-viewTickets" class="admin-nav-btn" onclick="switchMenu('viewTickets')">
          <span class="material-icons" style="color:#38bdf8;">support_agent</span>
          <span>Destek Talepleri</span>
        </button>
        <button id="btn-viewAdmins" class="admin-nav-btn" onclick="switchMenu('viewAdmins')">
          <span class="material-icons" style="color:#fbbf24;">shield</span>
          <span>Adminlik Yönetimi</span>
        </button>
      </div>

      <!-- Ana İçerik -->
      <div class="admin-content-panel">
        <%- include('partials/admin/sections/dashboard') %>
        <%- include('partials/admin/sections/users') %>
        <%- include('partials/admin/sections/labs') %>
        <%- include('partials/admin/sections/ctf') %>
        <%- include('partials/admin/sections/scenarios') %>
        <%- include('partials/admin/sections/system') %>
        <%- include('partials/admin/sections/teams') %>
        <%- include('partials/admin/sections/firstbloods') %>
        <%- include('partials/admin/sections/badges') %>
        <%- include('partials/admin/sections/bans') %>
        <%- include('partials/admin/sections/tickets') %>
        <%- include('partials/admin/sections/admins') %>
      </div>
    </div>
  </div>
</div>

<%- include('partials/admin/modals') %>
<script src="/js/notifications.js"></script>
<%- include('partials/admin/scripts') %>
</body>
</html>
