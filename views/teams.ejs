async function updateOnline() {
  try {
    const data = await (await fetch('/api/leaderboard')).json();
    const map = {};
    data.forEach(u => { map[u.username] = !!u.online; });
    document.querySelectorAll('[data-username]').forEach(row => {
      const online = !!map[row.dataset.username];
      const dot = row.querySelector('.sdot');
      const text = row.querySelector('.online-text');
      const state = row.querySelector('.online-state');
      if (dot) dot.classList.toggle('on', online);
      if (text) text.textContent = online ? 'Çevrimiçi' : 'Çevrimdışı';
      if (state) {
        state.classList.toggle('is-online', online);
        state.style.color = online ? '#10b981' : '#64748b';
      }
    });
  } catch(e) {}
}

async function createTeam() {
  const input = document.getElementById('teamNameInput');
  const name = input ? input.value.trim() : '';
  if (!name) return showMsg('createMsg', 'Takım adı girin.', 'error');
  const d = await (await fetch('/api/teams/create', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ name }) })).json();
  if (d.success) { showMsg('createMsg', d.message, 'success'); setTimeout(() => location.reload(), 900); }
  else showMsg('createMsg', d.message, 'error');
}

async function sendInvite() {
  const input = document.getElementById('inviteInput');
  const targetUsername = input ? input.value.trim() : '';
  if (!targetUsername) return showMsg('inviteMsg', 'Kullanıcı adı girin.', 'error');
  const d = await (await fetch('/api/teams/invite', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ targetUsername }) })).json();
  if (d.success) { showMsg('inviteMsg', d.message, 'success'); input.value = ''; }
  else showMsg('inviteMsg', d.message, 'error');
}

async function reqJoin(teamId, btn) {
