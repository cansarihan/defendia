<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <link rel="icon" type="image/png" href="/favicon.png">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Defendia Network Defense | Ana Sayfa</title>
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/animations.css">
  <link rel="stylesheet" href="/css/notifications.css">
  <script src="/js/notifications.js"></script>
  <link rel="stylesheet" href="/css/dashboard.css">
  <script>window.__searchData = <%- JSON.stringify(searchData) %>;</script>
</head>
<body>

<%
  // Sadece lab ve CTF çözümlerini say (senaryo görevleri hariç)
  const labIds  = new Set(Object.keys(labs));
  const ctfIds  = new Set(Object.keys(ctfChallenges));
  const solvedLabCtf = (user.solved || []).filter(id => labIds.has(id) || ctfIds.has(id)).length;
  const totalItems   = labIds.size + ctfIds.size;
  const masteryPct   = totalItems === 0 ? 0 : Math.min(100, Math.round((solvedLabCtf / totalItems) * 100));

  // Level sistemi: her 500 puan = 1 level
  let userPoints = 0;
  (user.solved || []).forEach(id => {
    if (labs[id])          userPoints += labs[id].points || 0;
    if (ctfChallenges[id]) userPoints += ctfChallenges[id].points || 0;
    if (typeof scenarios !== 'undefined') {
      Object.values(scenarios).forEach(s => {
        const task = (s.tasks || []).find(t => `${s.id}_task_${t.id}` === id);
        if (task) userPoints += task.points || 0;
      });
    }
  });
  const userLevel     = Math.min(10, Math.floor(userPoints / Math.ceil(maxPoints/10)) + 1);
  const levelProgress = userPoints % Math.ceil(maxPoints/10);
  const levelPct      = userLevel >= 10 ? 100 : Math.round((levelProgress / Math.ceil(maxPoints/10)) * 100);
%>

<div class="dash-shell">

  <!-- ══ SOL SIDEBAR ══ -->
  <%- include('partials/sidebar-only') %>

  <!-- ══ ANA ALAN ══ -->
  <div class="dash-main">

    <!-- Üst Bar -->
    <div class="dash-topbar">
      <!-- Sol: Durum -->
      <div class="dash-topbar-left" style="flex-shrink:0;">
        <div class="dash-status-tag" id="topbarStatus">
          DURUM: <span id="topbarStatusText" style="color:#10b981;">ÇEVRİMİÇİ</span>
          <span id="topbarStatusDot" style="display:inline-block;width:6px;height:6px;border-radius:50%;background:#10b981;box-shadow:0 0 6px #10b981;margin-left:5px;vertical-align:middle;"></span>
        </div>
      </div>

      <!-- Orta: Arama (genişletilmiş) -->
      <div style="flex:1;display:flex;justify-content:center;padding:0 24px;">
        <div class="dash-topbar-search" style="width:100%;max-width:480px;">
          <span class="material-icons">search</span>
          <input type="text" id="searchInput" placeholder="SİSTEM ARA..." style="width:100%;">
          <div class="search-dropdown" id="searchDropdown"></div>
        </div>
      </div>

      <%- include('partials/topbar-actions') %>
    </div>

    <!-- İçerik -->
    <div class="dash-content-area">

      <!-- Orta -->
      <div class="dash-center page-enter">

        <!-- Başlık -->
        <div class="dash-header-section">
         
          <div class="dash-operational-title">DEFENDIA NETWORK DEFENSE</div>
        </div>

        <!-- Sistem Duyurusu — kayar bant -->
        <div style="background:rgba(56,189,248,0.05);border:1px solid rgba(56,189,248,0.12);border-radius:6px;height:32px;display:flex;align-items:center;gap:12px;overflow:hidden;margin-bottom:0;flex-shrink:0;">
          <div style="background:rgba(56,189,248,0.15);border-right:1px solid rgba(56,189,248,0.2);padding:0 12px;height:100%;display:flex;align-items:center;flex-shrink:0;">
            <span style="font-size:9px;font-weight:700;color:#38bdf8;font-family:'JetBrains Mono',monospace;letter-spacing:2px;white-space:nowrap;">DEFENDIA</span>
          </div>
          <div style="flex:1;overflow:hidden;position:relative;">
            <div style="white-space:nowrap;animation:marquee 25s linear infinite;display:inline-block;font-size:11px;color:#64748b;font-family:'JetBrains Mono',monospace;">
              <%= (typeof systemAnnouncement !== 'undefined') ? systemAnnouncement : 'Defendia Network Defense operasyonel.' %>
              &nbsp;&nbsp;&nbsp;•&nbsp;&nbsp;&nbsp;
              <%= (typeof systemAnnouncement !== 'undefined') ? systemAnnouncement : 'Defendia Network Defense operasyonel.' %>
              &nbsp;&nbsp;&nbsp;•&nbsp;&nbsp;&nbsp;
              <%= (typeof systemAnnouncement !== 'undefined') ? systemAnnouncement : 'Defendia Network Defense operasyonel.' %>
            </div>
          </div>
        </div>

        <!-- Sistem Bildirimleri -->
        <% if(typeof systemNotifications !== 'undefined' && systemNotifications.length > 0) { %>
        <div style="background:rgba(17,24,39,0.6);border:1px solid rgba(255,255,255,0.06);border-top:none;border-radius:0 0 8px 8px;margin-bottom:16px;overflow:hidden;">
          <% systemNotifications.slice().reverse().forEach(notif => { %>
          <div style="display:flex;align-items:center;gap:10px;padding:8px 14px;border-bottom:1px solid rgba(255,255,255,0.04);">
            <span style="width:5px;height:5px;border-radius:50%;background:#38bdf8;flex-shrink:0;box-shadow:0 0 5px rgba(56,189,248,0.5);"></span>
            <span style="font-size:11px;color:#94a3b8;font-family:'JetBrains Mono',monospace;">[GÜNCELLEME DUYURUSU]</span>
            <span style="font-size:12px;color:#cbd5e1;flex:1;"><%= notif.message %></span>
          </div>
          <% }) %>
        </div>
        <% } else { %>
        <div style="margin-bottom:16px;"></div>
        <% } %>

        <!-- Operasyon özet metrikleri -->
        <div class="dash-data-grid fade-in-up">
          <div class="dash-data-card">
            <div class="dash-data-icon"><span class="material-icons">military_tech</span></div>
            <div>
              <div class="dash-data-value"><%= dashboardData.points %></div>
              <div class="dash-data-label">TOPLANAN PUAN</div>
            </div>
          </div>
          <div class="dash-data-card">
            <div class="dash-data-icon"><span class="material-icons">task_alt</span></div>
            <div>
              <div class="dash-data-value"><%= dashboardData.totals.solved %>/<%= dashboardData.totals.all %></div>
              <div class="dash-data-label">TOPLAM GÖREV</div>
            </div>
          </div>
          <div class="dash-data-card">
            <div class="dash-data-icon"><span class="material-icons">dns</span></div>
            <div>
              <div class="dash-data-value"><%= dashboardData.totals.labsSolved %>/<%= dashboardData.totals.labs %></div>
              <div class="dash-data-label">LAB DURUMU</div>
            </div>
          </div>
          <div class="dash-data-card">
            <div class="dash-data-icon"><span class="material-icons">route</span></div>
            <div>
              <div class="dash-data-value"><%= dashboardData.totals.scenarioTasksSolved %>/<%= dashboardData.totals.scenarioTasks %></div>
              <div class="dash-data-label">SENARYO ADIMI</div>
            </div>
          </div>
        </div>

        <!-- Hero Kart -->
        <% if(user.active_vmid) { %>
        <div class="dash-hero-card">
          <div class="dash-hero-bg"></div>
          <div class="dash-hero-content">
            <div>
              <div class="dash-hero-tag">
                <span class="dash-hero-tag-badge">AKTİF_GÖREV</span>
                <span class="dash-hero-tag-id">LAB_ID: <%= user.active_vmid_id || 'BİLİNMİYOR' %></span>
              </div>
              <div class="dash-hero-title">Aktif Operasyon</div>
              <div class="dash-hero-desc">Sistem hazır. Hedef makineye bağlantı kuruldu. Bayrağı ele geçir ve görevi tamamla.</div>
            </div>
            <div class="dash-hero-actions">
              <a href="/lab" class="dash-hero-btn">
                <span class="material-icons" style="font-size:14px;">play_arrow</span>
                DEVAM ET
              </a>
              <div class="dash-hero-ip" id="activeIpArea">
                MAKİNE_CANLI: Çözümleniyor...
              </div>
            </div>
          </div>
        </div>
        <% } else { %>
        <!-- Aktif lab yoksa kategori kartları -->
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:4px;">
          <a href="/lab" class="dash-hero-card dash-nav-card fade-in-up stagger-1" style="min-height:120px;text-decoration:none;">
            <div class="dash-hero-bg" style="background:linear-gradient(135deg,rgba(56,189,248,0.08) 0%,transparent 100%);"></div>
            <div class="dash-hero-content" style="padding:20px 24px;">
              <div class="dash-hero-tag"><span class="dash-hero-tag-badge" style="background:#38bdf8;">ALTYAPI</span></div>
              <div class="dash-hero-title" style="font-size:16px;">Laboratuvar</div>
              <div class="dash-hero-desc" style="font-size:11px;margin-bottom:0;">İzole sızma testi ortamları</div>
            </div>
          </a>
          <a href="/ctf" class="dash-hero-card dash-nav-card fade-in-up stagger-2" style="min-height:120px;text-decoration:none;">
            <div class="dash-hero-bg" style="background:linear-gradient(135deg,rgba(16,185,129,0.08) 0%,transparent 100%);"></div>
            <div class="dash-hero-content" style="padding:20px 24px;">
              <div class="dash-hero-tag"><span class="dash-hero-tag-badge">GÖREVLER</span></div>
              <div class="dash-hero-title" style="font-size:16px;color:#10b981;">CTF</div>
              <div class="dash-hero-desc" style="font-size:11px;margin-bottom:0;">Bayrak ele geçirme görevleri</div>
            </div>
          </a>
          <a href="/scenarios" class="dash-hero-card dash-nav-card fade-in-up stagger-3" style="min-height:120px;text-decoration:none;">
            <div class="dash-hero-bg" style="background:linear-gradient(135deg,rgba(167,139,250,0.08) 0%,transparent 100%);"></div>
            <div class="dash-hero-content" style="padding:20px 24px;">
              <div class="dash-hero-tag"><span class="dash-hero-tag-badge" style="background:#a78bfa;">SENARYOLAR</span></div>
              <div class="dash-hero-title" style="font-size:16px;color:#a78bfa;">Senaryolar</div>
              <div class="dash-hero-desc" style="font-size:11px;margin-bottom:0;">Kapsamlı operasyon simülasyonları</div>
            </div>
          </a>
        </div>
        <% } %>

        <!-- Alt İki Kart -->
        <div class="dash-bottom-grid">

          <!-- Global Mastery -->
          <div class="dash-card dash-anim-card" style="display:flex;flex-direction:column;">
            <div class="dash-card-title">
              <span>GENEL USTALAMA</span>
              <span class="material-icons" style="font-size:14px;color:#475569;">query_stats</span>
            </div>
            <div class="dash-mastery-pct"><%= masteryPct %>%</div>
            <div class="dash-mastery-label">GENEL USTALAMA</div>
            <div class="dash-mastery-bar">
              <div class="dash-mastery-fill" style="width:<%= masteryPct %>%;"></div>
            </div>
            <div class="dash-mastery-meta">
              <span>Tamamlanan: <%= solvedLabCtf %></span>
              <span>Toplam: <%= totalItems %></span>
            </div>

            <!-- Dolgu: Kategori özeti -->
            <div style="margin-top:auto;padding-top:16px;border-top:1px solid rgba(255,255,255,0.04);">
              <div style="font-size:9px;font-weight:700;color:#334155;letter-spacing:2px;font-family:'JetBrains Mono',monospace;margin-bottom:10px;">KATEGORİ ÖZETİ</div>
              <% Object.keys(stats).slice(0,4).forEach(cat => {
                const pct = Math.round((stats[cat].solved/stats[cat].total)*100)||0;
                const trMap = {'WEB':'Web','CRYPTO':'Kripto','FORENSICS':'Adli','REVERSING':'Tersine','PWN':'İstismar','OSINT':'OSINT','STEGANOGRAPHY':'Stego','MISC':'Çeşitli','SENARYOLAR':'Senaryo'};
                const label = trMap[cat.toUpperCase()] || cat;
                const color = pct===100?'#10b981':(pct>0?'#38bdf8':'#1e293b');
              %>
              <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
                <span style="font-size:10px;color:<%= pct>0?'#94a3b8':'#334155' %>;width:80px;flex-shrink:0;white-space:nowrap;"><%= label %></span>
                <div style="flex:1;height:3px;background:rgba(255,255,255,0.04);border-radius:3px;overflow:hidden;">
                  <div style="height:100%;background:<%= color %>;width:<%= pct %>%;border-radius:3px;transition:width 1s ease;"></div>
                </div>
                <span style="font-size:9px;color:#334155;font-family:'JetBrains Mono',monospace;width:28px;text-align:right;"><%= pct %>%</span>
              </div>
              <% }) %>
            </div>
          </div>

          <!-- Canlı Kayıt Akışı — Sadece İlk Kan -->
          <div class="dash-card dash-anim-card">
            <div class="dash-card-title">
              <span>🩸 İLK KAN SERİSİ</span>
              <span class="material-icons" style="font-size:14px;color:#ef4444;">bloodtype</span>
            </div>
            <div id="logFeed">
              <div class="dash-log-item">
                <span class="dash-log-time">--:--</span>
                <span class="dash-log-text">Yükleniyor...</span>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- Sağ Panel -->
      <div class="dash-right">

        <!-- Rozetler Kartı -->
        <div class="dash-right-card" style="padding:16px;">
          <div style="font-size:9px;font-weight:700;color:#475569;letter-spacing:2px;font-family:'JetBrains Mono',monospace;margin-bottom:12px;">ROZETLER (<%= dashBadges.length %>)</div>
          <% if(dashBadges.length === 0) { %>
            <div style="text-align:center;font-size:11px;color:#334155;font-family:'JetBrains Mono',monospace;padding:8px 0;">Henüz rozet yok</div>
          <% } else { %>
          <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;">
            <% dashBadges.forEach((b, bi) => { %>
              <button onclick="showDashBadgeModal(<%= bi %>)"
                title="<%= b.name %>"
                style="aspect-ratio:1;border-radius:12px;background:<%= b.color %>15;border:1.5px solid <%= b.color %>40;display:flex;align-items:center;justify-content:center;font-size:22px;cursor:pointer;transition:all 0.2s;"
                onmouseover="this.style.transform='scale(1.12)';this.style.borderColor='<%= b.color %>';this.style.boxShadow='0 0 14px <%= b.color %>44';"
                onmouseout="this.style.transform='scale(1)';this.style.borderColor='<%= b.color %>40';this.style.boxShadow='none';">
                <%= b.icon %>
              </button>
            <% }) %>
          </div>
          <% } %>
        </div>

        <!-- Yetkinlik Kartı — Yeni Tasarım -->
        <div class="dash-right-card" style="padding:0;overflow:hidden;border-color:rgba(56,189,248,0.1);">

          <!-- Üst gradient bölüm — circle ring -->
          <div style="background:linear-gradient(180deg,rgba(56,189,248,0.08) 0%,rgba(13,18,36,0) 100%);padding:24px 20px 16px;text-align:center;position:relative;">

            <!-- Başlık -->
            <div style="font-size:9px;font-weight:700;color:#475569;letter-spacing:3px;font-family:'JetBrains Mono',monospace;margin-bottom:20px;text-align:left;">YETKİNLİK DAĞILIMI</div>

            <!-- SVG Circle Progress Ring -->
            <div style="position:relative;width:120px;height:120px;margin:0 auto 8px;">
              <svg width="120" height="120" style="transform:rotate(-90deg);">
                <!-- Arka halka -->
                <circle cx="60" cy="60" r="50" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="6"/>
                <!-- Mor iç halka (dönen) -->
                <circle cx="60" cy="60" r="42" fill="none" stroke="rgba(167,139,250,0.15)" stroke-width="2"
                  stroke-dasharray="4 8" style="animation:hexRingSpin 12s linear infinite;transform-origin:60px 60px;"/>
                <!-- Progress halka -->
                <circle cx="60" cy="60" r="50" fill="none"
                  stroke="url(#levelGrad)" stroke-width="6"
                  stroke-linecap="round"
                  stroke-dasharray="<%= Math.round(2 * 3.14159 * 50) %>"
                  stroke-dashoffset="<%= Math.round(2 * 3.14159 * 50 * (1 - levelPct/100)) %>"
                  style="transition:stroke-dashoffset 1.5s ease;filter:drop-shadow(0 0 6px rgba(56,189,248,0.6));"/>
                <defs>
                  <linearGradient id="levelGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#38bdf8"/>
                    <stop offset="100%" stop-color="#a78bfa"/>
                  </linearGradient>
                </defs>
              </svg>
              <!-- Ortadaki içerik -->
              <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;">
                <div style="font-size:32px;font-weight:900;color:#38bdf8;font-family:'JetBrains Mono',monospace;line-height:1;text-shadow:0 0 16px rgba(56,189,248,0.5);"><%= userLevel %></div>
                <div style="font-size:8px;color:rgba(56,189,248,0.5);font-family:'JetBrains Mono',monospace;letter-spacing:2px;margin-top:2px;">SEVİYE</div>
              </div>
            </div>

            <!-- Unvan + puan -->
            <div style="font-size:11px;font-weight:700;color:#a78bfa;font-family:'JetBrains Mono',monospace;letter-spacing:1px;margin-bottom:4px;"><%= userLevel >= 10 ? 'ELİT MİMAR' : userLevel >= 8 ? 'UZMAN OPERATÖR' : userLevel >= 6 ? 'KIDEMLİ OPERATÖR' : userLevel >= 4 ? 'OPERATÖR' : 'ÇAYLAK' %></div>
            <div style="font-size:9px;color:#334155;font-family:'JetBrains Mono',monospace;">
              <% if(userLevel >= 10) { %>MAX SEVİYE<% } else { %><%= Math.ceil(maxPoints/10) - levelProgress %> puan → Seviye <%= userLevel + 1 %><% } %>
            </div>
          </div>

          <!-- Alt bölüm — kategori listesi -->
          <div style="padding:16px 20px;">
            <div style="font-size:9px;font-weight:700;color:#334155;letter-spacing:2px;font-family:'JetBrains Mono',monospace;margin-bottom:12px;">KATEGORİ DAĞILIMI</div>
            <% Object.keys(stats).forEach((cat) => {
              const pct = Math.round((stats[cat].solved / stats[cat].total) * 100) || 0;
              const trMap = {
                'WEB': 'Web Güvenliği', 'CRYPTO': 'Kriptoloji', 'FORENSICS': 'Adli Bilişim',
                'REVERSING': 'Tersine Müh.', 'PWN': 'İstismar', 'OSINT': 'OSINT',
                'STEGANOGRAPHY': 'Steganografi', 'MISC': 'Çeşitli', 'NETWORK': 'Ağ Güvenliği',
                'MOBILE': 'Mobil', 'CLOUD': 'Bulut', 'SENARYOLAR': 'Senaryolar'
              };
              const label = trMap[cat.toUpperCase()] || cat;
              const color = pct === 100 ? '#10b981' : (pct > 0 ? '#38bdf8' : '#1e293b');
              const textColor = pct === 100 ? '#10b981' : (pct > 0 ? '#94a3b8' : '#334155');
            %>
            <div style="margin-bottom:10px;">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;">
                <span style="font-size:11px;color:<%= textColor %>;font-weight:500;"><%= label %></span>
                <span style="font-size:9px;color:<%= pct===100?'#10b981':'#475569' %>;font-family:'JetBrains Mono',monospace;"><%= stats[cat].solved %>/<%= stats[cat].total %></span>
              </div>
              <div style="height:3px;background:rgba(255,255,255,0.04);border-radius:3px;overflow:hidden;">
                <div style="height:100%;background:<%= color %>;width:<%= pct %>%;border-radius:3px;transition:width 1s ease;<%= pct===100?'box-shadow:0 0 6px rgba(16,185,129,0.4);':'' %>"></div>
              </div>
            </div>
            <% }) %>
          </div>
        </div>

        <!-- Son çözümler -->
        <div class="dash-right-card">
          <div class="dash-right-title">
            <span>SON ÇÖZÜMLER</span>
            <span class="material-icons" style="font-size:14px;color:#10b981;">history</span>
          </div>
          <% if(dashboardData.recentSolves.length === 0) { %>
            <div class="dash-empty-mini">Henüz çözüm kaydı yok</div>
          <% } else { %>
            <% dashboardData.recentSolves.forEach(item => {
              const solvedDate = new Date(item.solvedAt);
            %>
              <a href="<%= item.href %>" class="dash-mini-row">
                <span class="dash-mini-dot solved"></span>
                <span class="dash-mini-main">
                  <span class="dash-mini-title"><%= item.title %></span>
                  <span class="dash-mini-sub"><%= item.type %> · <%= solvedDate.toLocaleDateString('tr-TR', { day:'2-digit', month:'2-digit' }) %> <%= solvedDate.toLocaleTimeString('tr-TR', { hour:'2-digit', minute:'2-digit' }) %></span>
                </span>
                <span class="dash-mini-points">+<%= item.points %></span>
              </a>
            <% }) %>
          <% } %>
        </div>

        <!-- Sıradaki hedefler -->
        <div class="dash-right-card">
          <div class="dash-right-title">
            <span>SIRADAKİ HEDEFLER</span>
            <span class="material-icons" style="font-size:14px;color:#38bdf8;">flag</span>
          </div>
          <% if(dashboardData.nextTargets.length === 0) { %>
            <div class="dash-empty-mini">Tüm hedefler tamamlandı</div>
          <% } else { %>
            <% dashboardData.nextTargets.forEach(item => { %>
              <a href="<%= item.href %>" class="dash-mini-row">
                <span class="dash-mini-dot"></span>
                <span class="dash-mini-main">
                  <span class="dash-mini-title"><%= item.title %></span>
                  <span class="dash-mini-sub"><%= item.type %> · <%= item.difficulty %></span>
                </span>
                <span class="dash-mini-points"><%= item.points %>p</span>
              </a>
            <% }) %>
          <% } %>
        </div>

        <!-- Zorluk kırılımı -->
        <div class="dash-right-card">
          <div class="dash-right-title">
            <span>ZORLUK KIRILIMI</span>
            <span class="material-icons" style="font-size:14px;color:#a78bfa;">stacked_bar_chart</span>
          </div>
          <% dashboardData.difficultyStats.forEach(diff => {
            const pct = diff.total ? Math.round((diff.solved / diff.total) * 100) : 0;
          %>
            <div class="dash-diff-row">
              <div class="dash-diff-head">
                <span><%= diff.label %></span>
                <span><%= diff.solved %>/<%= diff.total %></span>
              </div>
              <div class="dash-diff-bar"><div style="width:<%= pct %>%;"></div></div>
            </div>
          <% }) %>
          <div class="dash-data-foot">Kalan puan havuzu: <%= dashboardData.remainingPoints %></div>
        </div>

        <!-- Sunucu Durumu — KALDIRILDI -->

        <!-- Duyuru kaldırıldı — yukarıya taşındı -->

      </div>
    </div>
  </div>
</div>

<!-- Rozet Modal -->
<div id="dashBadgeModal" style="display:none;position:fixed;inset:0;background:rgba(8,12,24,0.88);z-index:9999;align-items:center;justify-content:center;backdrop-filter:blur(16px);" onclick="if(event.target===this)this.style.display='none'">
  <div id="dashBadgeModalInner" style="max-width:380px;width:90%;background:#0d1224;border-radius:20px;padding:40px 32px;text-align:center;position:relative;animation:fadeInUp 0.3s ease;max-height:85vh;overflow-y:auto;">
    <button onclick="document.getElementById('dashBadgeModal').style.display='none'" style="position:absolute;top:12px;right:12px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);border-radius:6px;width:26px;height:26px;color:#94a3b8;cursor:pointer;font-size:15px;display:flex;align-items:center;justify-content:center;line-height:1;">×</button>
    <div id="dashBadgeIcon" style="font-size:64px;margin-bottom:14px;"></div>
    <div id="dashBadgeName" style="font-size:13px;font-weight:800;letter-spacing:2px;font-family:'JetBrains Mono',monospace;margin-bottom:10px;"></div>
    <div id="dashBadgeDesc" style="font-size:12px;color:#94a3b8;line-height:1.6;"></div>
    <div id="dashBadgeCornerTL" style="position:absolute;top:10px;left:10px;width:14px;height:14px;border-top:2px solid;border-left:2px solid;border-radius:2px 0 0 0;opacity:0.6;"></div>
    <div id="dashBadgeCornerBR" style="position:absolute;bottom:10px;right:10px;width:14px;height:14px;border-bottom:2px solid;border-right:2px solid;border-radius:0 0 2px 0;opacity:0.6;"></div>
  </div>
</div>

<!-- Bildirim sistemi için SSE JS -->
<script>
/* ── Topbar Durum Güncelle ── */
function setTopbarStatus(online) {
  const txt = document.getElementById('topbarStatusText');
  const dot = document.getElementById('topbarStatusDot');
  if (!txt || !dot) return;
  if (online) {
    txt.textContent = 'ÇEVRİMİÇİ';
    txt.style.color = '#10b981';
    dot.style.background  = '#10b981';
    dot.style.boxShadow   = '0 0 6px #10b981';
  } else {
    txt.textContent = 'ÇEVRİMDIŞI';
    txt.style.color = '#ef4444';
    dot.style.background  = '#ef4444';
    dot.style.boxShadow   = '0 0 6px #ef4444';
  }
}

/* ── Leaderboard ── */
async function loadDashboardData() {
  try {
    const fbData = await fetch('/api/firstblood/recent').then(r => r.json()).catch(() => []);
    const logEl = document.getElementById('logFeed');
    if (!logEl) return;

    if (!fbData || fbData.length === 0) {
      logEl.innerHTML = '<div style="text-align:center;padding:20px 0;font-size:11px;color:#334155;font-family:\'JetBrains Mono\',monospace;">Henüz ilk kan yok</div>';
      return;
    }

    logEl.innerHTML = fbData.map(fb => {
      const d = new Date(fb.solvedAt);
      const dateStr = d.toLocaleDateString('tr-TR', { day:'2-digit', month:'2-digit' });
      const timeStr = d.toLocaleTimeString('tr-TR', { hour:'2-digit', minute:'2-digit' });
      // challengeTitle yoksa veya — ise gösterme
      const title = fb.challengeTitle && fb.challengeTitle !== '—' ? fb.challengeTitle : null;
      return `
        <div style="display:flex;align-items:flex-start;gap:10px;padding:10px 0;border-bottom:1px solid rgba(239,68,68,0.08);">
          <span style="font-size:16px;flex-shrink:0;margin-top:1px;">🩸</span>
          <div style="flex:1;min-width:0;">
            <div style="font-size:12px;font-weight:700;color:#fca5a5;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
              ${fb.username}${title ? ' → ' + title : ''}
            </div>
            <div style="font-size:9px;color:#475569;font-family:'JetBrains Mono',monospace;margin-top:2px;">${dateStr} ${timeStr} · İLK KAN</div>
          </div>
        </div>`;
    }).join('');
  } catch(e) {}
}

/* ── Proxmox Sunucu Durumu ── */
async function loadServerStatus() {
  const sub    = document.getElementById('pveSub');
  const status = document.getElementById('pveStatus');
  const icon   = document.getElementById('pveIcon');

  try {
    const res  = await fetch('/api/admin/pve-live-stats');
    const data = await res.json();

    if (data.success) {
      if (sub)    sub.textContent  = 'Altyapı çevrimiçi';
      if (status) { status.textContent = 'ÇEVRİMİÇİ'; status.style.color = '#10b981'; }
      if (icon)   { icon.style.background = 'rgba(16,185,129,0.1)'; icon.style.borderColor = 'rgba(16,185,129,0.3)'; icon.querySelector('.material-icons').style.color = '#10b981'; }
    } else {
      throw new Error();
    }
  } catch(e) {
    if (sub)    sub.textContent  = 'Bağlantı kurulamadı';
    if (status) { status.textContent = 'ÇEVRIMDIŞI'; status.style.color = '#ef4444'; }
    if (icon)   { icon.style.background = 'rgba(239,68,68,0.1)'; icon.style.borderColor = 'rgba(239,68,68,0.3)'; icon.querySelector('.material-icons').style.color = '#ef4444'; }
  }
}

loadDashboardData();
// loadServerStatus kaldırıldı — Proxmox bağlantısı olmadığında event loop'u bloke ediyordu

/* ── Rozet Modal ── */
const dashBadgesData = <%- JSON.stringify(dashBadges) %>;

function showDashBadgeModal(idx) {
  const b = dashBadgesData[idx];
  if (!b) return;
  const modal = document.getElementById('dashBadgeModal');
  const inner = document.getElementById('dashBadgeModalInner');
  document.getElementById('dashBadgeIcon').textContent = b.icon;
  const nameEl = document.getElementById('dashBadgeName');
  nameEl.textContent = b.name.toUpperCase();
  nameEl.style.color = b.color;

  // Açıklama + ilk kan listesi
  const descEl = document.getElementById('dashBadgeDesc');
  let descHtml = `<span style="color:#94a3b8;">${b.desc}</span>`;
  if (b.firstbloods && b.firstbloods.length > 0) {
    descHtml += `<div style="margin-top:14px;border-top:1px solid rgba(239,68,68,0.15);padding-top:12px;">
      <div style="font-size:9px;letter-spacing:2px;color:#ef4444;font-family:'JetBrains Mono',monospace;margin-bottom:8px;">İLK KAN ALINAN GÖREVLER</div>
      <div style="display:flex;flex-direction:column;gap:6px;">
        ${b.firstbloods.map(f => {
          const d = new Date(f.solvedAt);
          const dateStr = d.toLocaleDateString('tr-TR', { day:'2-digit', month:'2-digit', year:'numeric' });
          const timeStr = d.toLocaleTimeString('tr-TR', { hour:'2-digit', minute:'2-digit' });
          return `<div style="display:flex;align-items:center;justify-content:space-between;padding:6px 10px;background:rgba(239,68,68,0.06);border:1px solid rgba(239,68,68,0.15);border-radius:6px;">
            <span style="font-size:12px;color:#fca5a5;font-weight:600;">🩸 ${f.title}</span>
            <span style="font-size:9px;color:#475569;font-family:'JetBrains Mono',monospace;flex-shrink:0;margin-left:8px;">${dateStr} ${timeStr}</span>
          </div>`;
        }).join('')}
      </div>
    </div>`;
  }
  descEl.innerHTML = descHtml;

  inner.style.border = `2px solid ${b.color}`;
  inner.style.boxShadow = `0 0 60px ${b.color}44`;
  const tl = document.getElementById('dashBadgeCornerTL');
  const br = document.getElementById('dashBadgeCornerBR');
  if(tl) { tl.style.borderColor = b.color; }
  if(br) { br.style.borderColor = b.color; }
  modal.style.display = 'flex';
}

document.addEventListener('keydown', e => {
  if(e.key === 'Escape') document.getElementById('dashBadgeModal').style.display = 'none';
});

/* ── Bildirim Yardımcı Fonksiyonları ── */
function loadNotificationData() {
  var count   = parseInt(localStorage.getItem('notif_unread_count') || '0');
  var history = JSON.parse(localStorage.getItem('notif_history') || '[]');
  _updateBadge(count);
  _renderList(history);
}

function _updateBadge(n) {
  var b = document.getElementById('notifBadge');
  if (b) { b.textContent = n; b.classList.toggle('hidden', n === 0); }
}

function _renderList(h) {
  var l = document.getElementById('notifList');
  if (!l) return;
  if (!h.length) { l.innerHTML = '<div class="notif-empty">Henüz bildirim yok</div>'; return; }
  var c = { info:'#38bdf8', success:'#10b981', warning:'#fbbf24', danger:'#ef4444' };
  l.innerHTML = h.slice(-10).reverse().map(function(n) { return '<div class="notif-item" style="border-left-color:' + (c[n.severity]||c.info) + '"><div class="notif-item-message">' + n.message + '</div><div class="notif-item-time">' + _fmtT(n.createdAt) + '</div></div>'; }).join('');
}

function _fmtT(ts) {
  if (!ts) return 'Bilinmiyor';
  var diff = Math.floor((Date.now() - new Date(ts)) / 60000);
  if (diff < 1)  return 'Az önce';
  if (diff < 60) return diff + ' dk önce';
  var h = Math.floor(diff / 60);
  if (h < 24)    return h + ' saat önce';
  return new Date(ts).toLocaleDateString('tr-TR');
}

function markAllAsRead() {
  localStorage.setItem('notif_unread_count', '0');
  _updateBadge(0);
}

function clearAllNotifications() {
  localStorage.setItem('notif_history', '[]');
  localStorage.setItem('notif_unread_count', '0');
  _updateBadge(0);
  _renderList([]);
  var d = document.getElementById('notifDropdown');
  if (d) d.classList.remove('active');
}

/* ── Bildirim İşleme ── */
function handleNotification(notif) {
  showCriticalModal(notif);
  if (notif.sound !== false) _playSound('notif');
  var h = JSON.parse(localStorage.getItem('notif_history') || '[]');
  h.push(notif);
  var last10 = h.slice(-10);
  localStorage.setItem('notif_history', JSON.stringify(last10));
  _renderList(last10);
  var n = parseInt(localStorage.getItem('notif_unread_count') || '0') + 1;
  localStorage.setItem('notif_unread_count', n.toString());
  _updateBadge(n);
  _animateBell();
}

function _animateBell() {
  const btn = document.getElementById('notifBellBtn');
  if (btn) { btn.style.animation = 'bellPulse 2s'; setTimeout(() => btn.style.animation = '', 2000); }
}

/* ── Tam Ekran Bildirim Modalı ── */
function showCriticalModal(notif) {
  const existing = document.getElementById('criticalAlertOverlay');
  if (existing) existing.remove();
  const themes = {
    danger:  { color:'#ef4444', glow:'rgba(239,68,68,0.4)',  icon:'🚨', label:'KRİTİK UYARI', bg:'rgba(239,68,68,0.06)',  pulse:true  },
    warning: { color:'#fbbf24', glow:'rgba(251,191,36,0.4)', icon:'⚠️', label:'UYARI',         bg:'rgba(251,191,36,0.06)', pulse:false },
    success: { color:'#10b981', glow:'rgba(16,185,129,0.4)', icon:'✅', label:'BAŞARILI',       bg:'rgba(16,185,129,0.06)', pulse:false },
    info:    { color:'#38bdf8', glow:'rgba(56,189,248,0.4)', icon:'ℹ️', label:'BİLDİRİM',      bg:'rgba(56,189,248,0.06)', pulse:false },
  };
  const t = themes[notif.severity] || themes.info;
  const overlay = document.createElement('div');
  overlay.id = 'criticalAlertOverlay';
  overlay.style.cssText = 'position:fixed;top:0;left:0;width:100vw;height:100vh;background:rgba(8,12,24,0.9);z-index:99999;display:flex;align-items:center;justify-content:center;backdrop-filter:blur(16px);animation:pageEnter 0.35s ease;';
  overlay.innerHTML = `
    <div style="max-width:520px;width:90%;background:rgba(13,18,36,0.98);border:2px solid ${t.color};border-radius:16px;padding:48px 40px;text-align:center;box-shadow:0 0 80px ${t.glow};animation:fadeInUp 0.35s ease;position:relative;background-image:radial-gradient(ellipse at top,${t.bg} 0%,transparent 65%);">
      <div style="font-size:56px;margin-bottom:16px;${t.pulse?'animation:bellPulse 1s infinite;':''}">${t.icon}</div>
      <div style="font-size:9px;letter-spacing:4px;color:${t.color};text-transform:uppercase;font-weight:800;margin-bottom:12px;font-family:'JetBrains Mono',monospace;">${t.label}</div>
      <div style="font-size:18px;color:#f1f5f9;font-weight:700;line-height:1.6;margin-bottom:28px;">${notif.message}</div>
      <div style="font-size:10px;color:#475569;margin-bottom:28px;font-family:'JetBrains Mono',monospace;">${new Date(notif.createdAt).toLocaleString('tr-TR')}</div>
      <button id="criticalCloseBtn" style="background:${t.color};color:#080c18;border:none;padding:12px 44px;border-radius:8px;font-size:12px;font-weight:900;cursor:pointer;text-transform:uppercase;letter-spacing:2px;box-shadow:0 0 20px ${t.glow};font-family:'Inter',sans-serif;">ANLADIM</button>
      <div style="position:absolute;top:12px;left:12px;width:16px;height:16px;border-top:2px solid ${t.color};border-left:2px solid ${t.color};border-radius:2px 0 0 0;opacity:0.6;"></div>
      <div style="position:absolute;top:12px;right:12px;width:16px;height:16px;border-top:2px solid ${t.color};border-right:2px solid ${t.color};border-radius:0 2px 0 0;opacity:0.6;"></div>
      <div style="position:absolute;bottom:12px;left:12px;width:16px;height:16px;border-bottom:2px solid ${t.color};border-left:2px solid ${t.color};border-radius:0 0 0 2px;opacity:0.6;"></div>
      <div style="position:absolute;bottom:12px;right:12px;width:16px;height:16px;border-bottom:2px solid ${t.color};border-right:2px solid ${t.color};border-radius:0 0 2px 0;opacity:0.6;"></div>
    </div>`;
  document.body.appendChild(overlay);
  function close() { overlay.style.animation='fadeOut 0.3s forwards'; setTimeout(()=>overlay.remove(),300); document.removeEventListener('keydown',esc); }
  document.getElementById('criticalCloseBtn').addEventListener('click', close);
  function esc(e) { if(e.key==='Escape') close(); }
  document.addEventListener('keydown', esc);
  if (!t.pulse) overlay.addEventListener('click', e => { if(e.target===overlay) close(); });
}

/* ── Arama ── */
function performSearch(query) {
  const dd = document.getElementById('searchDropdown');
  const data = window.__searchData;
  if (!data) return;
  const ctf  = data.ctf.filter(i => i.title.toLowerCase().includes(query));
  const labs  = data.labs.filter(i => i.title.toLowerCase().includes(query));
  const sce   = data.scenarios.filter(i => i.title.toLowerCase().includes(query));
  if (!ctf.length && !labs.length && !sce.length) {
    dd.innerHTML = '<div class="search-no-results">Sonuç bulunamadı</div>';
    dd.classList.add('active'); return;
  }
  let html = '';
  if (ctf.length) { html += '<div class="search-category"><div class="search-category-title">CTF</div>'; ctf.forEach(i => { html += `<div class="search-result-item" onclick="location.href='/ctf'"><span class="search-result-title">${i.title}</span><span class="search-result-meta">${i.points} PTS</span></div>`; }); html += '</div>'; }
  if (labs.length) { html += '<div class="search-category"><div class="search-category-title">LAB</div>'; labs.forEach(i => { html += `<div class="search-result-item" onclick="location.href='/lab'"><span class="search-result-title">${i.title}</span><span class="search-result-meta">${i.points} PTS</span></div>`; }); html += '</div>'; }
  if (sce.length) { html += '<div class="search-category"><div class="search-category-title">SENARYO</div>'; sce.forEach(i => { html += `<div class="search-result-item" onclick="location.href='/scenario/${i.id}'"><span class="search-result-title">${i.title}</span><span class="search-result-meta">${i.points} PTS</span></div>`; }); html += '</div>'; }
  dd.innerHTML = html;
  dd.classList.add('active');
}

/* ── DOMContentLoaded ── */
document.addEventListener('DOMContentLoaded', () => {
  /* Arama */
  const inp = document.getElementById('searchInput');
  const dd  = document.getElementById('searchDropdown');
  if (inp && dd) {
    inp.addEventListener('input', e => {
      const q = e.target.value.trim().toLowerCase();
      if (q.length < 2) { dd.classList.remove('active'); return; }
      performSearch(q);
    });
    document.addEventListener('keydown', e => {
      if ((e.ctrlKey||e.metaKey) && e.key==='k') { e.preventDefault(); inp.focus(); }
      if (e.key === 'Escape') { dd.classList.remove('active'); inp.blur(); }
    });
    document.addEventListener('click', e => {
      if (!inp.contains(e.target) && !dd.contains(e.target)) dd.classList.remove('active');
    });
  }

  /* Bildirim zili */
  const bell = document.getElementById('notifBellBtn');
  const drop = document.getElementById('notifDropdown');
  if (bell && drop) {
    window._notifBellInited = true; // notifications.js'in tekrar init etmesini önle
    loadNotificationData();
    bell.addEventListener('click', e => {
      e.stopPropagation();
      const open = drop.classList.toggle('active');
      if (open) markAllAsRead();
    });
    document.addEventListener('click', e => {
      if (!bell.contains(e.target) && !drop.contains(e.target)) drop.classList.remove('active');
    });
    document.getElementById('notifClearBtn').addEventListener('click', clearAllNotifications);
  }

  /* SSE bağlantısı */
  let es = null, retries = 0;
  function connectSSE() {
    if (es) es.close();
    es = new EventSource('/api/notifications/stream');
    es.onopen = () => { retries = 0; setTopbarStatus(true); };
    es.onmessage = e => { try { processNotification(JSON.parse(e.data)); } catch(err) {} };
    es.onerror   = () => { setTopbarStatus(false); es.close(); if (retries++ < 3) setTimeout(connectSSE, 5000); };
    es.addEventListener('ping', () => { retries = 0; setTopbarStatus(true); });
  }
  connectSSE();
});

<% if(user.active_vmid) { %>
async function checkActiveLabIp() {
  try {
    const data = await (await fetch('/api/get-ip/0')).json();
    const el = document.getElementById('activeIpArea');
    if (data.ip && el) el.innerHTML = `MAKİNE_CANLI: <b style="color:#10b981;">${data.ip}</b>`;
    else if (data.expired) location.reload();
  } catch(e) {}
}
checkActiveLabIp();
setInterval(checkActiveLabIp, 5000);

async function terminateLab() {
  if (confirm('Operasyonu sonlandırmak üzeresiniz. Emin misiniz?')) {
    await fetch('/api/stop-lab', { method:'POST' });
    location.reload();
  }
}
<% } %>
</script>
</body>
