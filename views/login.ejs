<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <link rel="icon" type="image/png" href="/favicon.png">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Defendia Network Defense | Giriş Yap</title>
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/animations.css">
  <style>
    body { background: #080c18; display: flex; align-items: center; justify-content: center; height: 100vh; overflow: hidden; }
    canvas { position: fixed; inset: 0; z-index: 0; opacity: 0.06; pointer-events: none; }
    .auth-wrap { position: relative; z-index: 1; width: 380px; }
    .auth-logo { text-align: center; margin-bottom: 32px; }
    .auth-logo img { height: 90px; filter: drop-shadow(0 0 16px rgba(56,189,248,0.6)); }
    .auth-logo-text { font-family: 'JetBrains Mono', monospace; font-size: 10px; color: #475569; letter-spacing: 4px; text-transform: uppercase; margin-top: 8px; }
    .auth-card { background: #0d1224; border: 1px solid rgba(56,189,248,0.15); border-radius: 14px; padding: 32px; }
    .auth-title { font-size: 10px; font-weight: 700; color: #475569; letter-spacing: 3px; font-family: 'JetBrains Mono', monospace; text-transform: uppercase; margin-bottom: 24px; }
    .auth-input { width: 100%; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; padding: 11px 14px; font-size: 13px; color: #e2e8f0; font-family: 'Inter', sans-serif; outline: none; transition: all 0.2s; box-sizing: border-box; margin-bottom: 12px; }
    .auth-input:focus { border-color: rgba(56,189,248,0.4); background: rgba(56,189,248,0.04); }
    .auth-input::placeholder { color: #334155; }
    .auth-btn { width: 100%; padding: 12px; background: #38bdf8; border: none; border-radius: 8px; color: #080c18; font-size: 12px; font-weight: 800; cursor: pointer; font-family: 'JetBrains Mono', monospace; letter-spacing: 2px; text-transform: uppercase; transition: all 0.2s; margin-top: 4px; }
    .auth-btn:hover { box-shadow: 0 0 20px rgba(56,189,248,0.4); transform: translateY(-1px); }
    .auth-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
    .auth-msg { padding: 10px 14px; border-radius: 6px; font-size: 12px; font-weight: 600; margin-bottom: 16px; display: none; }
    .auth-msg.error { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #ef4444; }
    .auth-msg.success { background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.3); color: #10b981; }
    .auth-footer { text-align: center; margin-top: 20px; font-size: 12px; color: #475569; }
    .auth-footer a { color: #38bdf8; text-decoration: none; font-weight: 600; }
    /* Köşe dekorasyonları */
    .auth-card { position: relative; }
    .corner { position: absolute; width: 14px; height: 14px; }
    .corner.tl { top: 10px; left: 10px; border-top: 2px solid rgba(56,189,248,0.4); border-left: 2px solid rgba(56,189,248,0.4); border-radius: 2px 0 0 0; }
    .corner.tr { top: 10px; right: 10px; border-top: 2px solid rgba(56,189,248,0.4); border-right: 2px solid rgba(56,189,248,0.4); border-radius: 0 2px 0 0; }
    .corner.bl { bottom: 10px; left: 10px; border-bottom: 2px solid rgba(56,189,248,0.4); border-left: 2px solid rgba(56,189,248,0.4); border-radius: 0 0 0 2px; }
    .corner.br { bottom: 10px; right: 10px; border-bottom: 2px solid rgba(56,189,248,0.4); border-right: 2px solid rgba(56,189,248,0.4); border-radius: 0 0 2px 0; }
  </style>
</head>
<body class="page-enter">
<canvas id="matrix"></canvas>

<div class="auth-wrap">
  <div class="auth-logo">
    <img src="/defendialogo.png" alt="Defendia">
    <div class="auth-logo-text">DEFENDIA NETWORK DEFENSE</div>
  </div>

  <div class="auth-card">
    <div class="corner tl"></div><div class="corner tr"></div>
    <div class="corner bl"></div><div class="corner br"></div>

    <div class="auth-title">Sistem Erişimi // Giriş Yap</div>

    <div id="msg-box" class="auth-msg"></div>

    <form id="loginForm">
      <input type="text" name="username" class="auth-input" placeholder="Kullanıcı Adı" required autocomplete="off">
      <input type="password" name="password" class="auth-input" placeholder="Şifre" required>
      <button type="submit" class="auth-btn" id="submitBtn">GİRİŞ YAP</button>
    </form>

    <div class="auth-footer">
      Hesabın yok mu? <a href="/register">Kayıt Ol</a>
    </div>
  </div>
</div>

<script>
const form = document.getElementById('loginForm');
const msg  = document.getElementById('msg-box');
const btn  = document.getElementById('submitBtn');

form.onsubmit = async (e) => {
  e.preventDefault();
  btn.disabled = true; btn.textContent = 'AUTHENTICATING...';
  msg.style.display = 'none';
  try {
    const res = await fetch('/login', { method:'POST', body: new URLSearchParams(new FormData(form)), headers:{'Content-Type':'application/x-www-form-urlencoded'} });
    const r = await res.json();
    if(r.success) { window.location.href = '/dashboard'; }
    else if(r.banned) {
      btn.disabled=false; btn.textContent='GİRİŞ YAP';
      showBanModal(r);
    }
    else { msg.textContent = '⚠ Kullanıcı adı veya şifre hatalı!'; msg.className = 'auth-msg error'; msg.style.display = 'block'; btn.disabled=false; btn.textContent='GİRİŞ YAP'; }
  } catch(e) { msg.textContent = '⚠ Sunucu hatası!'; msg.className='auth-msg error'; msg.style.display='block'; btn.disabled=false; btn.textContent='GİRİŞ YAP'; }
};

const canvas = document.getElementById('matrix'), ctx = canvas.getContext('2d');
canvas.width = window.innerWidth; canvas.height = window.innerHeight;
const drops = Array(Math.ceil(canvas.width/16)).fill(1);
setInterval(() => {
  ctx.fillStyle='rgba(8,12,24,0.08)'; ctx.fillRect(0,0,canvas.width,canvas.height);
  ctx.fillStyle='#38bdf8'; ctx.font='14px monospace';
  drops.forEach((y,i) => { ctx.fillText(Math.floor(Math.random()*2),i*16,y*16); if(y*16>canvas.height&&Math.random()>0.975)drops[i]=0; drops[i]++; });
}, 50);

function showBanModal(ban) {
  const existing = document.getElementById('banOverlay');
  if (existing) existing.remove();
  const expText = ban.banExpires
    ? 'Yasak bitiş: ' + new Date(ban.banExpires).toLocaleString('tr-TR')
    : 'Süresiz yasak';
  const overlay = document.createElement('div');
  overlay.id = 'banOverlay';
  overlay.style.cssText = 'position:fixed;top:0;left:0;width:100vw;height:100vh;background:rgba(2,6,23,0.95);z-index:99999;display:flex;align-items:center;justify-content:center;backdrop-filter:blur(16px);';
  overlay.innerHTML = `
    <div style="max-width:500px;width:92%;background:rgba(10,15,30,0.98);border:2px solid #ef4444;border-radius:20px;padding:48px 36px;text-align:center;box-shadow:0 0 80px rgba(239,68,68,0.4);position:relative;">
      <div style="font-size:72px;margin-bottom:12px;">🚫</div>
      <div style="font-size:10px;letter-spacing:4px;color:#ef4444;text-transform:uppercase;font-weight:800;margin-bottom:14px;font-family:'JetBrains Mono',monospace;">ERİŞİM ENGELLENDİ</div>
      <div style="font-size:18px;color:#f1f5f9;font-weight:700;margin-bottom:20px;line-height:1.5;">Defendia Network Defense tarafından yasaklandınız.</div>
      <div style="background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.2);border-radius:10px;padding:16px;margin-bottom:20px;text-align:left;">
        <div style="display:flex;justify-content:space-between;margin-bottom:8px;">
          <span style="font-size:11px;color:#64748b;font-family:'JetBrains Mono',monospace;">SEBEP</span>
          <span style="font-size:12px;color:#fca5a5;font-weight:600;">${ban.banReason}</span>
        </div>
        <div style="display:flex;justify-content:space-between;margin-bottom:8px;">
          <span style="font-size:11px;color:#64748b;font-family:'JetBrains Mono',monospace;">YETKİLİ</span>
          <span style="font-size:12px;color:#94a3b8;">${ban.banAdmin}</span>
        </div>
        <div style="display:flex;justify-content:space-between;">
          <span style="font-size:11px;color:#64748b;font-family:'JetBrains Mono',monospace;">SÜRE</span>
          <span style="font-size:12px;color:${ban.banExpires ? '#fbbf24' : '#ef4444'};font-weight:600;">${expText}</span>
        </div>
      </div>
      <div style="font-size:11px;color:#475569;font-family:'JetBrains Mono',monospace;">İtiraz için platform yöneticisiyle iletişime geçin.</div>
      <div style="position:absolute;top:14px;left:14px;width:16px;height:16px;border-top:2px solid #ef4444;border-left:2px solid #ef4444;border-radius:2px 0 0 0;opacity:0.6;"></div>
      <div style="position:absolute;top:14px;right:14px;width:16px;height:16px;border-top:2px solid #ef4444;border-right:2px solid #ef4444;border-radius:0 2px 0 0;opacity:0.6;"></div>
      <div style="position:absolute;bottom:14px;left:14px;width:16px;height:16px;border-bottom:2px solid #ef4444;border-left:2px solid #ef4444;border-radius:0 0 0 2px;opacity:0.6;"></div>
      <div style="position:absolute;bottom:14px;right:14px;width:16px;height:16px;border-bottom:2px solid #ef4444;border-right:2px solid #ef4444;border-radius:0 0 2px 0;opacity:0.6;"></div>
    </div>
  `;
  document.body.appendChild(overlay);
}
</script>
</body>
</html>
