<div id="viewScenarios" class="menu-section">

  <div class="admin-card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
      <div class="admin-card-title" style="margin-bottom:0;"><span class="material-icons">map</span> Operasyon Senaryoları</div>
      <button class="admin-btn-add" onclick="openScenarioModal()">
        <span class="material-icons" style="font-size:14px;">add</span> Yeni Senaryo Ekle
      </button>
    </div>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Senaryo Başlığı</th>
            <th>Aşama Sayısı</th>
            <th>Zorluk</th>
            <th>Puan</th>
            <th>İşlemler</th>
          </tr>
        </thead>
        <tbody>
          <% if(typeof scenarios !== 'undefined') { %>
          <% Object.values(scenarios).forEach(s => { %>
          <tr>
            <td style="font-family:'JetBrains Mono',monospace;color:#94a3b8;font-size:11px;"><%= s.id %></td>
            <td style="font-weight:700;color:#38bdf8;"><%= s.title %></td>
            <td style="font-family:'JetBrains Mono',monospace;"><%= s.tasks ? s.tasks.length : 0 %> Aşama</td>
            <td>
              <span style="font-size:10px;padding:3px 8px;border-radius:4px;font-family:'JetBrains Mono',monospace;
                background:<%= s.difficulty==='Kolay'?'rgba(16,185,129,0.1)':s.difficulty==='Orta'?'rgba(251,191,36,0.1)':'rgba(239,68,68,0.1)' %>;
                color:<%= s.difficulty==='Kolay'?'#10b981':s.difficulty==='Orta'?'#fbbf24':'#ef4444' %>;">
                <%= s.difficulty %>
              </span>
            </td>
            <td style="font-family:'JetBrains Mono',monospace;color:#10b981;"><%= s.points %> PTS</td>
            <td style="display:flex;gap:6px;">
              <button onclick="editScenario('<%= s.id %>')" class="admin-btn admin-btn-edit">
                <span class="material-icons" style="font-size:12px;">edit</span> Düzenle
              </button>
              <button onclick="deleteScenario('<%= s.id %>')" class="admin-btn admin-btn-del">
                <span class="material-icons" style="font-size:12px;">delete</span> Sil
              </button>
            </td>
          </tr>
          <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>
