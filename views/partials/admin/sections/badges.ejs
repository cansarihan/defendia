<div id="viewBadges" class="menu-section">

  <!-- Rozet Listesi -->
  <div class="admin-card">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
      <div class="admin-card-title" style="margin-bottom:0;"><span class="material-icons" style="color:#fbbf24;">military_tech</span> Rozet Yönetimi</div>
      <button onclick="openCreateBadgeModal()" class="admin-btn-add" style="margin-bottom:0;">
        <span class="material-icons" style="font-size:14px;">add</span> Yeni Rozet
      </button>
    </div>
    <div id="adminBadgesList">
      <div style="text-align:center;padding:32px;color:#475569;font-family:'JetBrains Mono',monospace;font-size:12px;">Yükleniyor...</div>
    </div>
  </div>

</div>

<!-- Rozet Düzenle Modal -->
<div class="modal-overlay" id="badgeEditModal">
  <div class="modal-content" style="width:480px;">
    <span class="close-modal" onclick="closeModal('badgeEditModal')">&times;</span>
    <h3>Rozet Düzenle</h3>
    <input type="hidden" id="editBadgeId">

    <div style="display:grid;grid-template-columns:80px 1fr;gap:12px;align-items:start;">
      <!-- Önizleme -->
      <div style="text-align:center;">
        <div id="badgePreview" style="font-size:48px;line-height:1;margin-bottom:8px;">🏅</div>
        <div id="badgePreviewName" style="font-size:10px;color:#475569;font-family:'JetBrains Mono',monospace;">ROZET</div>
      </div>
      <div style="display:flex;flex-direction:column;gap:10px;">
        <div>
          <label class="admin-label">Rozet Adı</label>
          <input type="text" id="editBadgeName" class="modal-content input" placeholder="Rozet adı"
            style="background:rgba(0,0,0,0.3);border:1px solid rgba(255,255,255,0.08);color:white;padding:9px 12px;border-radius:8px;outline:none;font-size:13px;width:100%;box-sizing:border-box;"
            oninput="updateBadgePreview()">
        </div>
        <div>
          <label class="admin-label">Renk</label>
          <div style="display:flex;gap:8px;align-items:center;">
            <input type="color" id="editBadgeColor" value="#38bdf8"
              style="width:40px;height:36px;border:none;border-radius:6px;cursor:pointer;background:none;padding:2px;"
              oninput="updateBadgePreview()">
            <input type="text" id="editBadgeColorHex" placeholder="#38bdf8"
              style="flex:1;background:rgba(0,0,0,0.3);border:1px solid rgba(255,255,255,0.08);color:white;padding:9px 12px;border-radius:8px;outline:none;font-size:13px;font-family:'JetBrains Mono',monospace;"
              oninput="syncColorFromHex()">
          </div>
        </div>
      </div>
    </div>

    <div>
      <label class="admin-label">İkon Seç</label>
      <div style="display:grid;grid-template-columns:repeat(10,1fr);gap:6px;max-height:180px;overflow-y:auto;padding:8px;background:rgba(0,0,0,0.2);border-radius:8px;border:1px solid rgba(255,255,255,0.06);">
        <% const iconPack = ['👑','🧪','🩸','🚩','🔬','🗺️','✏️','⭐','🏆','🎯','🔥','💎','🛡️','⚔️','🎖️','🏅','🌟','💡','🔑','🎪','🦅','🐉','🌊','⚡','🎭','🔮','🦁','🐺','🦊','🐍','🌙','☀️','🌈','❄️','🌋','🏴','🚀','💻','🖥️','📡','🔐','🔓','🛸','🤖','👾','🎮','🕹️','📊','📈','🔭'] %>
        <% iconPack.forEach(ic => { %>
        <button onclick="selectBadgeIcon('<%= ic %>')" title="<%= ic %>"
          style="font-size:20px;padding:6px;border-radius:6px;border:1px solid transparent;background:rgba(255,255,255,0.03);cursor:pointer;transition:all 0.15s;line-height:1;"
          onmouseover="this.style.background='rgba(255,255,255,0.1)';this.style.borderColor='rgba(255,255,255,0.2)'"
          onmouseout="this.style.background='rgba(255,255,255,0.03)';this.style.borderColor='transparent'"
          id="iconBtn-<%= ic %>"><%= ic %></button>
        <% }) %>
      </div>
      <div style="margin-top:8px;display:flex;gap:8px;align-items:center;">
        <input type="text" id="editBadgeIcon" placeholder="Emoji gir veya yukarıdan seç"
          style="flex:1;background:rgba(0,0,0,0.3);border:1px solid rgba(255,255,255,0.08);color:white;padding:9px 12px;border-radius:8px;outline:none;font-size:16px;"
          oninput="updateBadgePreview()">
      </div>
    </div>

    <div>
      <label class="admin-label">Açıklama</label>
      <textarea id="editBadgeDesc" rows="2"
        style="width:100%;background:rgba(0,0,0,0.3);border:1px solid rgba(255,255,255,0.08);color:white;padding:9px 12px;border-radius:8px;outline:none;font-size:13px;resize:none;box-sizing:border-box;"
        placeholder="Rozet açıklaması..."></textarea>
    </div>

    <!-- Atama (sadece special/manual rozetler için) -->
    <div id="assignSection">
      <label class="admin-label">Kullanıcıya Ata</label>
      <div style="display:flex;gap:8px;">
        <select id="assignUserSelect"
          style="flex:1;background:rgba(0,0,0,0.3);border:1px solid rgba(255,255,255,0.08);color:white;padding:9px 12px;border-radius:8px;outline:none;font-size:13px;">
          <option value="">-- Kullanıcı Seç --</option>
        </select>
        <button onclick="assignBadgeToUser('add')" class="admin-btn admin-btn-edit" style="white-space:nowrap;">Ata</button>
        <button onclick="assignBadgeToUser('remove')" class="admin-btn admin-btn-del" style="white-space:nowrap;">Kaldır</button>
      </div>
      <div id="assignedUsersList" style="margin-top:8px;display:flex;flex-wrap:wrap;gap:6px;"></div>
    </div>

    <button onclick="saveBadgeEdit()" class="btn-save">Kaydet</button>
  </div>
</div>
