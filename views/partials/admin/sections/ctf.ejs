<div id="viewCtf" class="menu-section">

  <div class="admin-card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
      <div class="admin-card-title" style="margin-bottom:0;"><span class="material-icons">security</span> CTF Görevleri</div>
      <button class="admin-btn-add" onclick="openCtfModal()">
        <span class="material-icons" style="font-size:14px;">add</span> Yeni CTF Ekle
      </button>
    </div>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Görev ID</th>
            <th>Başlık</th>
            <th>Kategori</th>
            <th>Puan</th>
            <th>İşlemler</th>
          </tr>
        </thead>
        <tbody>
          <% Object.values(ctfChallenges).forEach(c => { %>
          <tr>
            <td style="font-family:'JetBrains Mono',monospace;color:#94a3b8;font-size:11px;"><%= c.id %></td>
            <td style="font-weight:700;color:#10b981;"><%= c.title %></td>
            <td>
              <span style="font-size:10px;padding:3px 8px;border-radius:4px;background:rgba(56,189,248,0.1);color:#38bdf8;font-family:'JetBrains Mono',monospace;">
                <%= c.category %>
              </span>
            </td>
            <td style="font-family:'JetBrains Mono',monospace;color:#10b981;"><%= c.points %> PTS</td>
            <td style="display:flex;gap:6px;">
              <button onclick="openCtfModal('<%= c.id %>')" class="admin-btn admin-btn-edit">
                <span class="material-icons" style="font-size:12px;">edit</span> Düzenle
              </button>
              <button onclick="deleteCtf('<%= c.id %>')" class="admin-btn admin-btn-del">
                <span class="material-icons" style="font-size:12px;">delete</span> Sil
              </button>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</div>
