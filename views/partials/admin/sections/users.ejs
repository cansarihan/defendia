<div id="viewUsers" class="menu-section">

  <div class="admin-card">
    <div class="admin-card-title"><span class="material-icons">group</span> Operatör Listesi</div>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Operatör</th>
            <th>Çözülen Görev</th>
            <th>Aktif VM</th>
            <th>Durum</th>
            <th>İşlemler</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
          <tr>
            <td style="font-weight:700;color:white;font-family:'JetBrains Mono',monospace;"><%= u.username %></td>
            <td><span style="color:#10b981;font-weight:700;"><%= (u.solved || []).length %></span> <span style="color:#475569;">bayrak</span></td>
            <td style="font-family:'JetBrains Mono',monospace;font-size:11px;">
              <% if(u.active_vmid) { %>
                <span style="color:#fbbf24;">VMID: <%= u.active_vmid %></span>
              <% } else { %>
                <span style="color:#334155;">—</span>
              <% } %>
            </td>
            <td>
              <span style="display:inline-flex;align-items:center;gap:5px;font-size:10px;font-family:'JetBrains Mono',monospace;color:#475569;">
                <span style="width:6px;height:6px;border-radius:50%;background:#475569;display:inline-block;"></span>
                ÇEVRİMDIŞI
              </span>
            </td>
            <td style="display:flex;gap:6px;flex-wrap:wrap;">
              <button onclick="resetUser('<%= u.id %>')" class="admin-btn admin-btn-reset">
                <span class="material-icons" style="font-size:12px;">refresh</span> Sıfırla
              </button>
              <button onclick="openChangePassword('<%= u.id %>','<%= u.username %>')" class="admin-btn" style="background:rgba(167,139,250,0.1);color:#a78bfa;border-color:rgba(167,139,250,0.3);">
                <span class="material-icons" style="font-size:12px;">lock_reset</span> Şifre
              </button>
              <% if(u.active_vmid) { %>
              <button onclick="stopUserVM('<%= u.id %>','<%= u.active_vmid %>')" class="admin-btn admin-btn-del" title="VM'i durdur ve sıfırla">
                <span class="material-icons" style="font-size:12px;">stop_circle</span> VM Kapat
              </button>
              <% } %>
              <button onclick="openBanModal('<%= u.id %>','<%= u.username %>')" class="admin-btn" style="background:rgba(239,68,68,0.08);color:#ef4444;border-color:rgba(239,68,68,0.3);">
                <span class="material-icons" style="font-size:12px;">block</span> Yasakla
              </button>
              <% if(u.username !== 'cansarihan') { %>
              <button onclick="deleteUser('<%= u.id %>')" class="admin-btn admin-btn-del">
                <span class="material-icons" style="font-size:12px;">delete</span> Sil
              </button>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</div>
