<div id="viewLabs" class="menu-section">

  <div class="admin-card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
      <div class="admin-card-title" style="margin-bottom:0;"><span class="material-icons">dns</span> Laboratuvar Makineleri</div>
      <button class="admin-btn-add" onclick="openLabModal()">
        <span class="material-icons" style="font-size:14px;">add</span> Yeni Lab Ekle
      </button>
    </div>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>VMID</th>
            <th>Makine Adı</th>
            <th>Zorluk</th>
            <th>Puan</th>
            <th>İşlemler</th>
          </tr>
        </thead>
        <tbody>
          <% Object.values(labs).forEach(l => { %>
          <tr>
            <td style="font-family:'JetBrains Mono',monospace;color:#94a3b8;"><%= l.id %></td>
            <td style="font-weight:700;color:#38bdf8;"><%= l.title %></td>
            <td>
              <span style="font-size:10px;padding:3px 8px;border-radius:4px;font-family:'JetBrains Mono',monospace;
                background:<%= l.difficulty==='Kolay'?'rgba(16,185,129,0.1)':l.difficulty==='Orta'?'rgba(251,191,36,0.1)':'rgba(239,68,68,0.1)' %>;
                color:<%= l.difficulty==='Kolay'?'#10b981':l.difficulty==='Orta'?'#fbbf24':'#ef4444' %>;">
                <%= l.difficulty %>
              </span>
            </td>
            <td style="font-family:'JetBrains Mono',monospace;color:#10b981;"><%= l.points %> PTS</td>
            <td style="display:flex;gap:6px;">
              <button onclick="openLabModal('<%= l.id %>')" class="admin-btn admin-btn-edit">
                <span class="material-icons" style="font-size:12px;">edit</span> Düzenle
              </button>
              <button onclick="deleteLab('<%= l.id %>')" class="admin-btn admin-btn-del">
                <span class="material-icons" style="font-size:12px;">delete</span> Sil
              </button>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</div>
