  async function addAdmin() {
    const username = document.getElementById('addAdminSelect').value;
    const msgEl    = document.getElementById('adminMsgEl');
    if (!username) { showAdminMsg('Kullanıcı seçin.', false); return; }
    const res  = await fetch('/api/admin/admins/add', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ username }) });
    const data = await res.json();
    showAdminMsg(data.message, data.success);
    if (data.success) loadAdminList();
  }

  async function removeAdmin(username) {
    if (!confirm(`"${username}" kullanıcısının adminliğini kaldırmak istediğinize emin misiniz?`)) return;
    const res  = await fetch('/api/admin/admins/remove', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ username }) });
    const data = await res.json();
    showAdminMsg(data.message, data.success);
    if (data.success) loadAdminList();
  }

  function showAdminMsg(text, ok) {
    const el = document.getElementById('adminMsgEl');
    if (!el) return;
    el.textContent    = text;
    el.style.display  = 'block';
    el.style.background = ok ? 'rgba(16,185,129,0.1)' : 'rgba(239,68,68,0.1)';
    el.style.border     = ok ? '1px solid rgba(16,185,129,0.3)' : '1px solid rgba(239,68,68,0.3)';
    el.style.color      = ok ? '#10b981' : '#ef4444';
    setTimeout(() => { el.style.display = 'none'; }, 4000);
  }

