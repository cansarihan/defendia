  async function deleteFirstBlood(challengeId, title) {
    if (!confirm('"' + title + '" görevinin ilk kan kaydını silmek istediğinize emin misiniz?')) return;
    const res  = await fetch('/api/admin/delete-firstblood', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ challengeId }) });
    const data = await res.json();
    if (data.success) { showToast(data.message, 'success'); loadAdminFirstBloods(); }
    else showToast(data.message || 'Silinemedi!', 'error');
  }

  async function resetAllFirstBloods() {
    if (!confirm('TÜM ilk kan kayıtlarını sıfırlamak istediğinize emin misiniz?\nBu işlem geri alınamaz!')) return;
    const res  = await fetch('/api/admin/reset-firstbloods', { method:'POST' });
    const data = await res.json();
    if (data.success) { showToast(data.message, 'success'); loadAdminFirstBloods(); }
    else showToast('Sıfırlanamadı!', 'error');
  }

  // ── Takım Yönetimi (Admin) ──
