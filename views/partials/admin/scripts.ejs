                  <td><span style="font-size:10px;padding:2px 8px;border-radius:3px;background:rgba(167,139,250,0.1);color:#a78bfa;border:1px solid rgba(167,139,250,0.25);font-family:'JetBrains Mono',monospace;">${t.category}</span></td>
                  <td style="font-size:11px;color:#475569;font-family:'JetBrains Mono',monospace;">${d.toLocaleDateString('tr-TR')} ${d.toLocaleTimeString('tr-TR',{hour:'2-digit',minute:'2-digit'})}</td>
                  <td><span style="display:inline-flex;align-items:center;gap:4px;padding:3px 8px;border-radius:4px;font-size:10px;font-weight:700;font-family:'JetBrains Mono',monospace;background:${sc}18;color:${sc};border:1px solid ${sc}44;">
