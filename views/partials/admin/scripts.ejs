  function openCreateBadgeModal() {
    _currentBadgeId = null;
    document.getElementById('editBadgeId').value   = '';
    document.getElementById('editBadgeName').value  = '';
    document.getElementById('editBadgeIcon').value  = '🏅';
    document.getElementById('editBadgeColor').value = '#38bdf8';
    document.getElementById('editBadgeColorHex').value = '#38bdf8';
    document.getElementById('editBadgeDesc').value  = '';
    document.getElementById('assignedUsersList').innerHTML = '';
    document.getElementById('assignSection').style.display = 'block';
    populateUserSelect();
    updateBadgePreview();
    document.getElementById('badgeEditModal').classList.add('active');
  }

  function openEditBadgeModal(b) {
    _currentBadgeId = b.id;
    document.getElementById('editBadgeId').value   = b.id;
    document.getElementById('editBadgeName').value  = b.name;
    document.getElementById('editBadgeIcon').value  = b.icon;
    document.getElementById('editBadgeColor').value = b.color || '#38bdf8';
    document.getElementById('editBadgeColorHex').value = b.color || '#38bdf8';
    document.getElementById('editBadgeDesc').value  = b.desc || '';
    const showAssign = ['special','manual'].includes(b.type);
    document.getElementById('assignSection').style.display = showAssign ? 'block' : 'none';
    if (showAssign) {
      populateUserSelect();
      renderAssignedUsers(b.assignedTo || []);
    }
    updateBadgePreview();
    document.getElementById('badgeEditModal').classList.add('active');
  }

  function populateUserSelect() {
    const sel = document.getElementById('assignUserSelect');
    if (!sel) return;
    sel.innerHTML = '<option value="">-- Kullanıcı Seç --</option>' +
      _badgeUsers.map(u => `<option value="${u.username}">${u.username}</option>`).join('');
  }

  function renderAssignedUsers(list) {
    const el = document.getElementById('assignedUsersList');
    if (!el) return;
    el.innerHTML = list.map(u => `
      <span style="display:inline-flex;align-items:center;gap:4px;padding:3px 8px;background:rgba(56,189,248,0.1);border:1px solid rgba(56,189,248,0.3);border-radius:4px;font-size:11px;color:#38bdf8;font-family:'JetBrains Mono',monospace;">
        ${u}
      </span>
    `).join('');
  }

  function selectBadgeIcon(icon) {
    document.getElementById('editBadgeIcon').value = icon;
    updateBadgePreview();
  }

  function updateBadgePreview() {
    const icon  = document.getElementById('editBadgeIcon').value || '🏅';
    const name  = document.getElementById('editBadgeName').value || 'ROZET';
    const color = document.getElementById('editBadgeColor').value || '#38bdf8';
    const prev  = document.getElementById('badgePreview');
    const pname = document.getElementById('badgePreviewName');
    if (prev)  prev.textContent  = icon;
    if (pname) { pname.textContent = name.toUpperCase(); pname.style.color = color; }
    document.getElementById('editBadgeColorHex').value = color;
  }

  function syncColorFromHex() {
    const hex = document.getElementById('editBadgeColorHex').value;
    if (/^#[0-9a-fA-F]{6}$/.test(hex)) {
      document.getElementById('editBadgeColor').value = hex;
      updateBadgePreview();
    }
  }

  async function saveBadgeEdit() {
    const id    = document.getElementById('editBadgeId').value;
    const name  = document.getElementById('editBadgeName').value.trim();
    const icon  = document.getElementById('editBadgeIcon').value.trim();
    const color = document.getElementById('editBadgeColorHex').value.trim() || document.getElementById('editBadgeColor').value;
    const desc  = document.getElementById('editBadgeDesc').value.trim();
    if (!name || !icon) return showToast('İsim ve ikon zorunlu!', 'error');

    let url, body;
    if (id) {
      url  = '/api/admin/badge/update';
      body = { id, name, icon, color, desc };
    } else {
      url  = '/api/admin/badge/create';
      body = { name, icon, color, desc, type: 'manual' };
    }
    const res  = await fetch(url, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body) });
    const data = await res.json();
    if (data.success) { showToast(data.message, 'success'); closeModal('badgeEditModal'); loadAdminBadges(); }
    else showToast(data.message || 'Hata!', 'error');
  }

  async function assignBadgeToUser(action) {
    const badgeId  = document.getElementById('editBadgeId').value;
    const username = document.getElementById('assignUserSelect').value;
    if (!badgeId || !username) return showToast('Rozet ID ve kullanıcı gerekli.', 'error');
    const res  = await fetch('/api/admin/badge/assign', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ badgeId, username, action }) });
    const data = await res.json();
    if (data.success) {
      showToast(data.message, 'success');
      // Atanan listesini güncelle
      const badgesData = await (await fetch('/api/admin/badges')).json();
      const b = badgesData.badges.find(x => x.id === badgeId);
      if (b) renderAssignedUsers(b.assignedTo || []);
    } else showToast(data.message || 'Hata!', 'error');
  }

  async function deleteBadge(id, name) {
    if (!confirm('"' + name + '" rozetini silmek istediğinize emin misiniz?')) return;
    const res  = await fetch('/api/admin/badge/delete', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ id }) });
    const data = await res.json();
    if (data.success) { showToast(data.message, 'success'); loadAdminBadges(); }
    else showToast(data.message || 'Silinemedi!', 'error');
  }

  // ── İlk Kan Yönetimi (Admin) ──
