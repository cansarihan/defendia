          <table class="admin-table">
            <thead>
              <tr>
                <th>Görev</th>
                <th>Tür</th>
                <th>İlk Çözen</th>
                <th>Tarih & Saat</th>
                <th>İşlem</th>
              </tr>
            </thead>
            <tbody>
              ${data.list.map(fb => `
                <tr>
                  <td style="font-weight:700;color:white;">${fb.title}</td>
                  <td>
                    <span style="font-size:10px;padding:2px 8px;border-radius:3px;background:${typeColors[fb.type]}22;color:${typeColors[fb.type]};border:1px solid ${typeColors[fb.type]}44;font-family:'JetBrains Mono',monospace;font-weight:700;">${fb.type}</span>
                  </td>
                  <td style="color:#ef4444;font-weight:700;font-family:'JetBrains Mono',monospace;">🩸 ${fb.username}</td>
                  <td style="font-size:11px;color:#475569;font-family:'JetBrains Mono',monospace;">${new Date(fb.solvedAt).toLocaleString('tr-TR')}</td>
                  <td>
                    <button onclick="deleteFirstBlood('${fb.challengeId}','${fb.title.replace(/'/g,"\\'")}')" class="admin-btn admin-btn-del" style="padding:5px 10px;">
                      <span class="material-icons" style="font-size:12px;">delete</span> Sil
                    </button>
                  </td>
                </tr>
              `).join('')}
            </tbody>
          </table>
