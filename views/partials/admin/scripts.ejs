              <div style="background:${bc};border:1px solid ${bord};border-radius:${isAdmin?'10px 0 10px 10px':'0 10px 10px 10px'};padding:10px 14px;font-size:12px;color:#cbd5e1;line-height:1.6;white-space:pre-wrap;">${r.message}</div>
