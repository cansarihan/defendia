                  <td style="font-size:11px;color:#475569;font-family:'JetBrains Mono',monospace;">${new Date(b.bannedAt).toLocaleDateString('tr-TR')}</td>
                  <td style="font-size:11px;font-family:'JetBrains Mono',monospace;color:${b.expiresAt ? '#fbbf24' : '#ef4444'};">
