<script>
  // ═══════════════════════════════════════════
  //  ADMIN PANEL — SCRIPTS
  // ═══════════════════════════════════════════

  const rawLabs      = <%- JSON.stringify(labs || {}) %>;
  const rawCtf       = <%- JSON.stringify(ctfChallenges || {}) %>;
  const rawScenarios = <%- typeof scenarios !== 'undefined' ? JSON.stringify(scenarios) : '{}' %>;

  // ── Yardımcı: ID ile veri bul ──
  function findDataById(source, id) {
    if (Array.isArray(source)) return source.find(item => item.id == id);
    return source[id];
  }

  // ── Toast ──
  function showToast(message, type) {
    type = type || 'success';
    const c = document.getElementById('toast-container');
    const t = document.createElement('div');
    t.className = 'toast ' + type;
    t.innerText = message;
    c.appendChild(t);
    setTimeout(() => t.remove(), 3000);
  }

  // ── Menü Geçişi ──
  function switchMenu(sectionId) {
    document.querySelectorAll('.menu-section').forEach(s => s.classList.remove('active'));
    document.querySelectorAll('.admin-nav-btn').forEach(b => b.classList.remove('active'));
    const target = document.getElementById(sectionId);
    if (target) target.classList.add('active');
    const btn = document.getElementById('btn-' + sectionId);
    if (btn) btn.classList.add('active');
    localStorage.setItem('activeAdminTab', sectionId);
    const titles = {
      viewDashboard: 'SİSTEM İSTATİSTİKLERİ',
      viewUsers:     'OPERATÖR YÖNETİMİ',
      viewLabs:      'LABORATUVAR MAKİNELERİ',
      viewCtf:       'CTF GÖREVLERİ',
      viewScenarios: 'OPERASYON SENARYOLARI',
      viewSystem:    'DUYURU & BİLDİRİMLER',
      viewTeams:     'TAKIM YÖNETİMİ',
      viewFirstBloods: 'İLK KAN KAYITLARI',
      viewBadges:      'ROZET YÖNETİMİ',
      viewBans:        'YASAKLAMA YÖNETİMİ',
      viewTickets:     'DESTEK TALEPLERİ',
      viewAdmins:      'ADMİNLİK YÖNETİMİ'
    };
    const el = document.getElementById('adminPageTitle');
    if (el) el.textContent = titles[sectionId] || 'YÖNETİM PANELİ';
    if (sectionId === 'viewTeams') loadAdminTeams();
    if (sectionId === 'viewFirstBloods') loadAdminFirstBloods();
    if (sectionId === 'viewBadges') loadAdminBadges();
    if (sectionId === 'viewBans')   loadAdminBans();
    if (sectionId === 'viewTickets') loadAdminTickets();
    if (sectionId === 'viewAdmins')  loadAdminList();
  }

  function closeModal(id) {
    const m = document.getElementById(id);
    if (m) m.classList.remove('active');
  }

  // ── Proxmox Canlı Güncelleme ──
  async function refreshPveStats() {
    try {
      const res  = await fetch('/api/admin/pve-live-stats');
      const data = await res.json();
      if (!data.success) return;

      document.getElementById('pve-status-text').innerText = 'SİSTEM STABİL';
      document.getElementById('pve-temp').innerText        = data.temp || 45;
      document.getElementById('pve-temp-bar').style.width  = (data.temp || 45) + '%';

      document.getElementById('pve-cpu').innerText         = data.cpu;
      document.getElementById('pve-cpu-bar').style.width   = data.cpu + '%';

      const ramUsed    = parseFloat(data.ram.used);
      const ramTotal   = 128;
      const ramPercent = (ramUsed / ramTotal) * 100;
      document.getElementById('pve-ram-used').innerText  = ramUsed;
      document.getElementById('pve-ram-free').innerText  = (ramTotal - ramUsed).toFixed(1) + ' GB Boş Alan';
      document.getElementById('pve-ram-bar').style.width = ramPercent + '%';

      const diskContainer = document.getElementById('pve-disk-list');
      if (diskContainer) {
        diskContainer.innerHTML = data.disks.map(disk => `
          <div class="admin-stat-card" style="margin-bottom:10px;">
            <div class="admin-stat-label">Disk: ${disk.name}</div>
            <div class="admin-stat-value" style="font-size:18px;">${disk.used} / ${disk.total} GB</div>
            <div class="admin-progress-bg">
              <div class="admin-progress-fill" style="width:${(disk.used/disk.total)*100}%;background:#38bdf8;"></div>
            </div>
          </div>
        `).join('');
      }

      const vmTbody = document.getElementById('pve-vm-list-tbody');
      if (vmTbody) {
        vmTbody.innerHTML = data.vms.map(vm => `
          <tr>
            <td style="font-family:monospace;color:#94a3b8;">${vm.vmid}</td>
            <td style="font-weight:bold;color:white;">${vm.name}</td>
            <td><span class="sys-badge" style="color:${vm.status==='running'?'#10b981':'#ef4444'};border-color:${vm.status==='running'?'#10b981':'#ef4444'}">${vm.status.toUpperCase()}</span></td>
            <td style="font-size:11px;color:#94a3b8;">CPU: %${vm.cpu} | RAM: ${vm.ram} MB</td>
          </tr>
        `).join('');
      }

      const activeCount = data.vms.filter(v => v.name.startsWith('lab-') && v.status === 'running').length;
      const el = document.getElementById('active-lab-count');
      if (el) el.innerText = activeCount;
    } catch (err) { console.error('PVE Sync Error:', err); }
  }

  // ── Lab Modal & Kaydet ──
  function openLabModal(id) {
    id = id || null;
    if (id) {
      const l = findDataById(rawLabs, id);
      if (l) {
        document.getElementById('labId').value     = l.id;
        document.getElementById('labTitle').value  = l.title;
        document.getElementById('labDiff').value   = l.difficulty;
        document.getElementById('labPoints').value = l.points;
        document.getElementById('labFlag').value   = l.flag;
        document.getElementById('labHint').value   = l.hint;
      }
    } else {
      ['labId','labTitle','labPoints','labFlag','labHint'].forEach(id => { document.getElementById(id).value = ''; });
    }
    document.getElementById('labModal').classList.add('active');
  }

  async function saveLab() {
    const data = {
      id:         document.getElementById('labId').value,
      title:      document.getElementById('labTitle').value,
      difficulty: document.getElementById('labDiff').value,
      points:     document.getElementById('labPoints').value,
      flag:       document.getElementById('labFlag').value,
      hint:       document.getElementById('labHint').value
    };
    const res = await fetch('/api/admin/save-lab', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(data) });
    if ((await res.json()).success) location.reload();
    else showToast('Kayıt başarısız!', 'error');
  }

  async function deleteLab(id) {
    if (!confirm('Bu laboratuvarı silmek istediğinize emin misiniz?')) return;
    const res = await fetch('/api/admin/delete-lab', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ id }) });
    if ((await res.json()).success) location.reload();
    else showToast('Silme başarısız!', 'error');
  }

  // ── CTF Modal & Kaydet ──
  function openCtfModal(id) {
    id = id || null;
    if (id) {
      const c = findDataById(rawCtf, id);
      if (c) {
        document.getElementById('ctfId').value       = c.id;
        document.getElementById('ctfTitle').value    = c.title;
        document.getElementById('ctfCat').value      = c.category;
        document.getElementById('ctfPoints').value   = c.points;
        document.getElementById('ctfFlag').value     = c.flag;
        document.getElementById('ctfDownload').value = c.download;
        document.getElementById('ctfHint').value     = c.hint;
      }
    } else {
      ['ctfId','ctfTitle','ctfCat','ctfPoints','ctfFlag','ctfDownload','ctfHint'].forEach(id => { document.getElementById(id).value = ''; });
    }
    document.getElementById('ctfModal').classList.add('active');
  }

  async function saveCtf() {
    const data = {
      id:       document.getElementById('ctfId').value,
      title:    document.getElementById('ctfTitle').value,
      category: document.getElementById('ctfCat').value,
      points:   document.getElementById('ctfPoints').value,
      flag:     document.getElementById('ctfFlag').value,
      hint:     document.getElementById('ctfHint').value,
      download: document.getElementById('ctfDownload').value
    };
    const res = await fetch('/api/admin/save-ctf', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(data) });
    if ((await res.json()).success) location.reload();
    else showToast('Kayıt başarısız!', 'error');
  }

  async function deleteCtf(id) {
    if (!confirm('Bu CTF görevini silmek istediğinize emin misiniz?')) return;
    const res = await fetch('/api/admin/delete-ctf', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ id }) });
    if ((await res.json()).success) location.reload();
    else showToast('Silme başarısız!', 'error');
  }

  // ── Senaryo Editörü ──
  function openScenarioModal() {
    ['sceId','sceTitle','sceDesc','sceVmid','scePoints','sceBanner'].forEach(id => { document.getElementById(id).value = ''; });
    document.getElementById('sceId').readOnly = false;
    document.getElementById('sceTasksContainer').innerHTML = '';
    document.getElementById('scenarioModal').classList.add('active');
  }

  function editScenario(id) {
    const s = findDataById(rawScenarios, id);
    if (!s) return;
    document.getElementById('sceId').value     = s.id;
    document.getElementById('sceId').readOnly  = true;
    document.getElementById('sceTitle').value  = s.title;
    document.getElementById('sceDesc').value   = s.description;
    document.getElementById('sceVmid').value   = s.vmid;
    document.getElementById('sceDiff').value   = s.difficulty;
    document.getElementById('scePoints').value = s.points;
    document.getElementById('sceBanner').value = s.banner || '';
    const container = document.getElementById('sceTasksContainer');
    container.innerHTML = '';
    if (s.tasks) s.tasks.forEach(t => addTaskEntry(t));
    document.getElementById('scenarioModal').classList.add('active');
  }

  function addTaskEntry(data) {
    data = data || {};
    const container = document.getElementById('sceTasksContainer');
    const div = document.createElement('div');
    div.className = 'task-entry';
    div.innerHTML = `
      <div class="task-entry-title">AŞAMA <span class="btn-remove-task" onclick="this.parentElement.parentElement.remove()">[-]</span></div>
      <input type="text" class="t-title" placeholder="Başlık" value="${data.title || ''}">
      <textarea class="t-question" style="height:60px;margin:5px 0;">${data.question || ''}</textarea>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:5px;">
        <input type="text"   class="t-flag"   placeholder="Flag"  value="${data.flag   || ''}">
        <input type="number" class="t-points" placeholder="Puan"  value="${data.points || ''}">
      </div>
      <input type="hidden" class="t-id" value="${data.id || Date.now()}">
    `;
    container.appendChild(div);
  }

  async function saveScenario() {
    const tasks = Array.from(document.querySelectorAll('#sceTasksContainer .task-entry')).map(entry => ({
      id:       entry.querySelector('.t-id').value,
      title:    entry.querySelector('.t-title').value,
      question: entry.querySelector('.t-question').value,
      flag:     entry.querySelector('.t-flag').value,
      points:   parseInt(entry.querySelector('.t-points').value) || 0
    }));
    const data = {
      id:          document.getElementById('sceId').value,
      title:       document.getElementById('sceTitle').value,
      description: document.getElementById('sceDesc').value,
      vmid:        parseInt(document.getElementById('sceVmid').value) || 0,
      difficulty:  document.getElementById('sceDiff').value,
      points:      parseInt(document.getElementById('scePoints').value) || 0,
      banner:      document.getElementById('sceBanner').value,
      tasks
    };
    const res = await fetch('/api/admin/save-scenario', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(data) });
    if ((await res.json()).success) location.reload();
    else showToast('Kayıt başarısız!', 'error');
  }

  async function deleteScenario(id) {
    if (!confirm('Bu senaryoyu silmek istediğinize emin misiniz?')) return;
    const res = await fetch('/api/admin/delete-scenario', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ id }) });
    if ((await res.json()).success) location.reload();
    else showToast('Silme başarısız!', 'error');
  }

  // ── Kullanıcı İşlemleri ──
  async function resetUser(userId) {
    if (!confirm('Bu kullanıcının tüm ilerlemesini sıfırlamak istediğinize emin misiniz?')) return;
    const res = await fetch('/api/admin/reset-progress', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ userId }) });
    if ((await res.json()).success) { showToast('Kullanıcı sıfırlandı.', 'success'); location.reload(); }
    else showToast('Sıfırlama başarısız!', 'error');
  }

  async function deleteUser(userId) {
    if (!confirm('Bu kullanıcıyı sistemden kaldırmak istediğinize emin misiniz?')) return;
    const res = await fetch('/api/admin/delete-user', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ userId }) });
    if ((await res.json()).success) { showToast('Kullanıcı silindi.', 'success'); location.reload(); }
    else showToast('Silme başarısız!', 'error');
  }

  async function stopUserVM(userId, vmid) {
    if (!confirm(`VMID ${vmid} makinesini durdurmak ve kullanıcının VM kaydını sıfırlamak istediğinize emin misiniz?`)) return;
    showToast('VM kapatılıyor...', 'success');
    const res  = await fetch('/api/admin/stop-user-vm', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ userId }) });
    const data = await res.json();
    if (data.success) { showToast(data.message, 'success'); setTimeout(() => location.reload(), 1500); }
    else showToast(data.message || 'Hata!', 'error');
  }

  // ── Şifre Değiştir ──
  function openChangePassword(userId, username) {
    document.getElementById('cpUserId').value    = userId;
    document.getElementById('cpUsername').textContent = username;
    document.getElementById('cpNewPassword').value    = '';
    document.getElementById('cpConfirmPassword').value = '';
    const msg = document.getElementById('cpMsg');
    msg.style.display = 'none';
    document.getElementById('changePasswordModal').classList.add('active');
  }

  async function submitChangePassword() {
    const userId      = document.getElementById('cpUserId').value;
    const newPassword = document.getElementById('cpNewPassword').value;
    const confirm2    = document.getElementById('cpConfirmPassword').value;
    const msg         = document.getElementById('cpMsg');

    function showCpMsg(text, ok) {
      msg.textContent   = text;
      msg.style.display = 'block';
      msg.style.background = ok ? 'rgba(16,185,129,0.1)' : 'rgba(239,68,68,0.1)';
      msg.style.border     = ok ? '1px solid rgba(16,185,129,0.3)' : '1px solid rgba(239,68,68,0.3)';
      msg.style.color      = ok ? '#10b981' : '#ef4444';
    }

    if (!newPassword || newPassword.length < 4) return showCpMsg('Şifre en az 4 karakter olmalı.', false);
    if (newPassword !== confirm2)               return showCpMsg('Şifreler eşleşmiyor.', false);

    const res  = await fetch('/api/admin/change-password', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ userId, newPassword }) });
    const data = await res.json();
    if (data.success) {
      showCpMsg('✅ ' + data.message, true);
      setTimeout(() => closeModal('changePasswordModal'), 1500);
    } else {
      showCpMsg('❌ ' + (data.message || 'Hata!'), false);
    }
  }

  // ── Duyuru & Bildirim ──
  async function updateAnnouncement() {
    const announcement = document.getElementById('announcementInput').value;
    const res = await fetch('/api/admin/announcement', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ announcement }) });
    if ((await res.json()).success) showToast('Duyuru güncellendi.', 'success');
    else showToast('Güncelleme başarısız!', 'error');
  }

  async function addNotification() {
    const message = document.getElementById('notifInput').value.trim();
    if (!message) return;
    const res = await fetch('/api/admin/notification', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ message }) });
    if ((await res.json()).success) location.reload();
    else showToast('Eklenemedi!', 'error');
  }

  async function deleteNotification(id) {
    const res = await fetch('/api/admin/notification/delete', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ id }) });
    if ((await res.json()).success) location.reload();
    else showToast('Silinemedi!', 'error');
  }

  // ── Dosya Yükleme ──
  async function uploadCtfFileAdmin() {
    const fileInput = document.getElementById('ctfFileInputAdmin');
    if (!fileInput.files[0]) return;
    const formData = new FormData();
    formData.append('ctfFile', fileInput.files[0]);
    const res  = await fetch('/api/admin/upload-ctf-file', { method:'POST', body: formData });
    const data = await res.json();
    if (data.success) {
      document.getElementById('ctfDownload').value = data.filePath;
      showToast('Dosya yüklendi: ' + data.filePath, 'success');
    } else showToast('Yükleme başarısız!', 'error');
  }

  async function uploadScenarioBannerAdmin() {
    const fileInput = document.getElementById('sceFileInput');
    if (!fileInput.files[0]) return;
    const formData = new FormData();
    formData.append('sceBanner', fileInput.files[0]);
    const res  = await fetch('/api/admin/upload-scenario-banner', { method:'POST', body: formData });
    const data = await res.json();
    if (data.success) {
      document.getElementById('sceBanner').value = data.filePath;
      showToast('Banner yüklendi.', 'success');
    } else showToast('Yükleme başarısız!', 'error');
  }

  // ── Hedefli Bildirim Gönder ──
  async function sendTargetedNotification() {
    const targetUserId = document.getElementById('targetUserSelect').value;
    const message      = document.getElementById('notificationMessage').value.trim();
    const severity     = document.getElementById('severitySelect').value;
    const sound        = document.getElementById('soundToggle').checked;
    if (!targetUserId) { showNotifResult('Lütfen bir kullanıcı seçin.', 'error'); return; }
    if (!message)      { showNotifResult('Lütfen bir mesaj yazın.', 'error'); return; }
    const res  = await fetch('/api/admin/notification/send', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ targetUserId, message, severity, sound }) });
    const data = await res.json();
    if (data.success) {
      const opt = document.getElementById('targetUserSelect').options[document.getElementById('targetUserSelect').selectedIndex];
      showNotifResult(data.delivered ? '✅ Bildirim ' + opt.text + ' kullanıcısına iletildi.' : '📭 ' + opt.text + ' çevrimdışı, bildirim beklemede.', data.delivered ? 'success' : 'info');
      document.getElementById('notificationMessage').value = '';
    } else showNotifResult('❌ Bildirim gönderilemedi.', 'error');
  }

  async function sendBroadcastNotification() {
    const message  = document.getElementById('notificationMessage').value.trim();
    const severity = document.getElementById('severitySelect').value;
    const sound    = document.getElementById('soundToggle').checked;
    if (!message) { showNotifResult('Lütfen bir mesaj yazın.', 'error'); return; }
    if (!confirm('Tüm kullanıcılara "' + message + '" mesajını göndermek istediğinize emin misiniz?')) return;
    const res  = await fetch('/api/admin/notification/broadcast', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ message, severity, sound }) });
    const data = await res.json();
    if (data.success) {
      showNotifResult('📢 ' + data.deliveredCount + ' kullanıcıya iletildi.', 'success');
      document.getElementById('notificationMessage').value = '';
    } else showNotifResult('❌ Broadcast gönderilemedi.', 'error');
  }

  function showNotifResult(message, type) {
    const el = document.getElementById('notificationResult');
    if (!el) return;
    el.textContent  = message;
    el.className    = type;
    el.style.display = 'block';
    setTimeout(() => { el.style.display = 'none'; }, 5000);
  }

  // ── Çevrimiçi Kullanıcı Kontrolü ──
  async function checkOnlineUsers() {
    try {
      const res  = await fetch('/api/admin/online-users');
      const data = await res.json();
      if (data.success && data.onlineUsers) {
        const select = document.getElementById('targetUserSelect');
        if (select) {
          Array.from(select.options).forEach(option => {
            if (option.value) {
              const isOnline = data.onlineUsers.map(String).includes(String(option.value));
              option.setAttribute('data-online', isOnline.toString());
              if (option.selected) updateUserStatusDisplay(isOnline);
            }
          });
        }
      }
    } catch (err) { console.error('Çevrimiçi kontrol hatası:', err); }
  }

  function updateUserStatusDisplay(isOnline) {
    const el = document.getElementById('onlineStatus');
    if (!el) return;
    if (isOnline) {
      el.innerHTML   = '<span class="online-dot online"></span> Çevrimiçi';
      el.style.color = '#10b981';
    } else {
      el.innerHTML   = '<span class="online-dot offline"></span> Çevrimdışı';
      el.style.color = '#94a3b8';
    }
  }

  // ── Bildirim Bell (Admin) ──
  let _adminNotifs = JSON.parse(localStorage.getItem('adminNotifs') || '[]');

  function _adminUpdateBadge() {
    const unread = _adminNotifs.filter(n => !n.read).length;
    const badge  = document.getElementById('notifBadge');
    if (badge) badge.style.display = unread > 0 ? 'block' : 'none';
  }

  function _adminRenderList() {
    const list = document.getElementById('notifList');
    if (!list) return;
    if (_adminNotifs.length === 0) {
      list.innerHTML = '<div style="padding:20px;text-align:center;color:#475569;font-size:12px;font-family:JetBrains Mono,monospace;">Bildirim yok</div>';
      return;
    }
    list.innerHTML = _adminNotifs.slice().reverse().map((n, i) => `
      <div style="padding:10px 16px;border-bottom:1px solid rgba(255,255,255,0.04);opacity:${n.read?0.5:1};">
        <div style="font-size:12px;color:#e2e8f0;line-height:1.4;">${n.message}</div>
        <div style="font-size:10px;color:#475569;margin-top:3px;font-family:JetBrains Mono,monospace;">${new Date(n.createdAt).toLocaleString('tr-TR')}</div>
      </div>
    `).join('');
  }

  function handleNotification(notif) {
    _adminNotifs.push({ ...notif, read: false });
    if (_adminNotifs.length > 50) _adminNotifs = _adminNotifs.slice(-50);
    localStorage.setItem('adminNotifs', JSON.stringify(_adminNotifs));
    _adminUpdateBadge();
    _adminRenderList();
  }

  function markAllAsRead() {
    _adminNotifs.forEach(n => n.read = true);
    localStorage.setItem('adminNotifs', JSON.stringify(_adminNotifs));
    _adminUpdateBadge();
    _adminRenderList();
  }

  function clearAllNotifications() {
    _adminNotifs = [];
    localStorage.setItem('adminNotifs', JSON.stringify(_adminNotifs));
    _adminUpdateBadge();
    _adminRenderList();
  }

  // ── Adminlik Yönetimi ──
  async function loadAdminList() {
    const container = document.getElementById('adminListCurrent');
    const select    = document.getElementById('addAdminSelect');
    if (!container) return;
    try {
      const data = await (await fetch('/api/admin/admins')).json();
      if (!data.success) return;

      // Mevcut adminler
      container.innerHTML = data.admins.map(a => `
        <div style="display:flex;align-items:center;gap:12px;padding:10px 14px;background:rgba(251,191,36,0.04);border:1px solid rgba(251,191,36,0.15);border-radius:8px;margin-bottom:8px;">
          ${a.avatar
            ? `<img src="${a.avatar}" style="width:34px;height:34px;border-radius:50%;object-fit:cover;border:2px solid rgba(251,191,36,0.4);">`
