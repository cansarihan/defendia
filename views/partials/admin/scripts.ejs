                    : b.active ? '<span style="font-size:9px;color:#ef4444;font-family:JetBrains Mono,monospace;border:1px solid rgba(239,68,68,0.3);padding:2px 6px;border-radius:3px;background:rgba(239,68,68,0.08);">AKTİF</span>'
                    : '<span style="font-size:9px;color:#10b981;font-family:JetBrains Mono,monospace;border:1px solid rgba(16,185,129,0.3);padding:2px 6px;border-radius:3px;">KALDIRILDI</span>'}
                  </td>
                  <td>
                    ${b.active && !b.expired ? `<button onclick="unbanUser('${b.userId}','${b.username}')" class="admin-btn admin-btn-edit" style="padding:5px 10px;">
                      <span class="material-icons" style="font-size:12px;">lock_open</span> Kaldır
                    </button>` : '—'}
