    modal.style.display = 'flex';
  }

  async function submitAdminReply(ticketId) {
    const msg = document.getElementById('adminReplyMsg')?.value.trim();
    if (!msg) return showToast('Yanıt yazın.', 'error');
    const res  = await fetch('/api/admin/ticket/reply', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ ticketId, message: msg }) });
    const data = await res.json();
    if (data.success) { showToast('Yanıt gönderildi.', 'success'); document.getElementById('ticketDetailModal').style.display='none'; loadAdminTickets(); }
    else showToast(data.message || 'Hata!', 'error');
  }

  async function changeTicketStatus(ticketId, status) {
    const res  = await fetch('/api/admin/ticket/status', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ ticketId, status }) });
    const data = await res.json();
    if (data.success) { showToast('Durum güncellendi.', 'success'); document.getElementById('ticketDetailModal').style.display='none'; loadAdminTickets(); }
    else showToast('Hata!', 'error');
  }

  // ── Yasaklama Yönetimi (Admin) ──
  let _banSelectedDays = null;

  function openBanModal(userId, username) {
    document.getElementById('banUserId').value = userId;
    document.getElementById('banUsername').textContent = username;
    document.getElementById('banReason').value = '';
    document.getElementById('banDurationDisplay').textContent = '';
    document.getElementById('customDaysRow').style.display = 'none';
    document.querySelectorAll('.ban-preset-btn').forEach(b => b.classList.remove('active'));
    _banSelectedDays = null;
    document.getElementById('banModal').classList.add('active');
  }

  function setBanDays(days) {
    _banSelectedDays = days;
    document.querySelectorAll('.ban-preset-btn').forEach(b => b.classList.remove('active'));
    const btn = document.querySelector(`.ban-preset-btn[data-days="${days}"]`);
    if (btn) btn.classList.add('active');
    const display = document.getElementById('banDurationDisplay');
    const customRow = document.getElementById('customDaysRow');
    if (days === -1) {
      customRow.style.display = 'block';
      display.textContent = '';
    } else {
      customRow.style.display = 'none';
      if (days === 0) display.textContent = '⚠ Süresiz yasak — manuel kaldırılana kadar devam eder.';
      else {
        const exp = new Date(Date.now() + days * 86400000);
        display.textContent = `Bitiş: ${exp.toLocaleDateString('tr-TR')} ${exp.toLocaleTimeString('tr-TR')}`;
      }
    }
  }

  async function submitBan() {
    const userId = document.getElementById('banUserId').value;
    const reason = document.getElementById('banReason').value.trim();
    let days = _banSelectedDays;
    if (days === -1) {
      days = parseInt(document.getElementById('banCustomDays').value);
      if (!days || days < 1) return showToast('Geçerli bir gün sayısı girin.', 'error');
    }
    if (days === null) return showToast('Yasak süresi seçin.', 'error');
    if (!reason) return showToast('Yasak sebebi yazın.', 'error');
    const finalDays = days === 0 ? null : days;
    const res  = await fetch('/api/admin/ban-user', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ userId, reason, days: finalDays }) });
    const data = await res.json();
    if (data.success) { showToast(data.message, 'success'); closeModal('banModal'); location.reload(); }
    else showToast(data.message || 'Hata!', 'error');
  }

