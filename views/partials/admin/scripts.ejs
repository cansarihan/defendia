                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      `;
    } catch(e) {
      container.innerHTML = '<div style="text-align:center;padding:24px;color:#ef4444;font-size:12px;">Yüklenemedi.</div>';
    }
