        <div style="display:flex;gap:10px;margin-top:10px;">
          <button onclick="submitAdminReply('${t.id}')" class="admin-btn-primary" style="flex:1;">
            <span class="material-icons" style="font-size:14px;">send</span> Yanıtla
          </button>
          <button onclick="changeTicketStatus('${t.id}','closed')" class="admin-btn admin-btn-del" style="padding:10px 16px;">
            Kapat
          </button>
