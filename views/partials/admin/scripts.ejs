      const data = await (await fetch('/api/admin/firstbloods')).json();
      if (!data.success || !data.list.length) {
        container.innerHTML = '<div style="text-align:center;padding:32px;color:#475569;font-family:JetBrains Mono,monospace;font-size:12px;">Henüz ilk kan kaydı yok.</div>';
