  async function deleteTeam(teamId, teamName) {
    if (!confirm('"' + teamName + '" takımını silmek istediğinize emin misiniz?\nTüm üyeler takımdan çıkarılacak.')) return;
    const res  = await fetch('/api/admin/delete-team', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ teamId }) });
    const data = await res.json();
    if (data.success) { showToast(data.message, 'success'); loadAdminTeams(); }
    else showToast(data.message || 'Silinemedi!', 'error');
  }

  // ── Kritik Modal ──
  function showCriticalModal(notif) {
    const existing = document.getElementById('criticalAlertOverlay');
    if (existing) existing.remove();
    const themes = {
      danger:  { color:'#ef4444', glow:'rgba(239,68,68,0.4)',  icon:'🚨', label:'KRİTİK UYARI' },
      warning: { color:'#fbbf24', glow:'rgba(251,191,36,0.4)', icon:'⚠️', label:'UYARI' },
      success: { color:'#10b981', glow:'rgba(16,185,129,0.4)', icon:'✅', label:'BAŞARILI' },
      info:    { color:'#38bdf8', glow:'rgba(56,189,248,0.4)', icon:'ℹ️', label:'BİLDİRİM' }
    };
    const t = themes[notif.severity] || themes.info;
    const overlay = document.createElement('div');
    overlay.id = 'criticalAlertOverlay';
    overlay.style.cssText = 'position:fixed;top:0;left:0;width:100vw;height:100vh;background:rgba(2,6,23,0.88);z-index:99999;display:flex;align-items:center;justify-content:center;backdrop-filter:blur(14px);';
    overlay.innerHTML = `
      <div style="max-width:520px;width:90%;background:rgba(10,15,30,0.97);border:2px solid ${t.color};border-radius:20px;padding:48px 36px;text-align:center;box-shadow:0 0 60px ${t.glow};position:relative;">
        <div style="font-size:56px;margin-bottom:16px;">${t.icon}</div>
        <div style="font-size:10px;letter-spacing:4px;color:${t.color};text-transform:uppercase;font-weight:800;margin-bottom:12px;font-family:'JetBrains Mono',monospace;">${t.label}</div>
        <div style="font-size:18px;color:#f1f5f9;font-weight:700;line-height:1.6;margin-bottom:28px;">${notif.message}</div>
        <div style="font-size:11px;color:#475569;margin-bottom:28px;font-family:'JetBrains Mono',monospace;">${new Date(notif.createdAt).toLocaleString('tr-TR')}</div>
        <button id="criticalCloseBtn" style="background:${t.color};color:#020617;border:none;padding:12px 44px;border-radius:10px;font-size:12px;font-weight:900;cursor:pointer;text-transform:uppercase;letter-spacing:2px;">ANLADIM</button>
      </div>
    `;
    document.body.appendChild(overlay);
    function doClose() { overlay.remove(); document.removeEventListener('keydown', esc); }
    document.getElementById('criticalCloseBtn').addEventListener('click', doClose);
    function esc(e) { if (e.key === 'Escape') doClose(); }
    document.addEventListener('keydown', esc);
    overlay.addEventListener('click', e => { if (e.target === overlay) doClose(); });
  }

  // ── DOMContentLoaded ──
  document.addEventListener('DOMContentLoaded', () => {
    // Aktif sekmeyi geri yükle
    const savedTab = localStorage.getItem('activeAdminTab') || 'viewDashboard';
    switchMenu(savedTab);
    if (savedTab === 'viewTeams') loadAdminTeams();
    // Proxmox polling
    refreshPveStats();
    setInterval(() => {
      if (localStorage.getItem('activeAdminTab') === 'viewDashboard') refreshPveStats();
    }, 90000);  // 90 saniye

    // Bildirim bell toggle
    const bellBtn = document.getElementById('notifBellBtn');
    const dropdown = document.getElementById('notifDropdown');
    if (bellBtn && dropdown) {
      bellBtn.addEventListener('click', e => {
        e.stopPropagation();
        const open = dropdown.style.display === 'block';
        dropdown.style.display = open ? 'none' : 'block';
        if (!open) { markAllAsRead(); }
      });
      document.addEventListener('click', e => {
        if (!dropdown.contains(e.target) && e.target !== bellBtn) {
          dropdown.style.display = 'none';
        }
      });
    }

    // Bildirim listesini yükle
    _adminUpdateBadge();
    _adminRenderList();

    // Çevrimiçi kullanıcı kontrolü
    const userSelect = document.getElementById('targetUserSelect');
    if (userSelect) {
      userSelect.addEventListener('change', function() {
        const isOnline = this.options[this.selectedIndex].getAttribute('data-online') === 'true';
        updateUserStatusDisplay(isOnline);
      });
      setTimeout(checkOnlineUsers, 1000);
      setInterval(checkOnlineUsers, 15000);
    }

    // SSE bağlantısı
    let sseSource = null;
    let sseRetry  = 0;
    function connectSSE() {
      if (sseSource) sseSource.close();
      sseSource = new EventSource('/api/notifications/stream');
      sseSource.onmessage = e => {
        try {
          const notif = JSON.parse(e.data);
          processNotification(notif);
          showCriticalModal(notif);
        } catch(err) {}
      };
      sseSource.onerror = () => {
        sseSource.close();
        if (sseRetry < 5) { sseRetry++; setTimeout(connectSSE, 5000); }
      };
      sseSource.addEventListener('ping', () => { sseRetry = 0; });
    }
    connectSSE();
  });
</script>
