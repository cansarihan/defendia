  async function unbanUser(userId, username) {
    if (!confirm(`"${username}" kullanıcısının yasağını kaldırmak istediğinize emin misiniz?`)) return;
    const res  = await fetch('/api/admin/unban-user', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ userId }) });
    const data = await res.json();
    if (data.success) { showToast(data.message, 'success'); loadAdminBans(); }
    else showToast(data.message || 'Hata!', 'error');
  }

