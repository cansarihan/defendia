<!-- Topbar sağ ikonlar: yalnız bildirim -->
<div class="dash-topbar-right">
  <div style="position:relative;">
    <button class="dash-icon-btn" id="notifBellBtn" title="Bildirimler">
      <span class="material-icons">notifications_active</span>
      <span class="notif-badge hidden" id="notifBadge">0</span>
    </button>
    <div class="notif-dropdown" id="notifDropdown">
      <div class="notif-dropdown-header">Bildirimler</div>
      <div class="notif-list" id="notifList"><div class="notif-empty">Henüz bildirim yok</div></div>
      <button class="notif-clear-btn" id="notifClearBtn">Tümünü Temizle</button>
    </div>
  </div>
</div>
