<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <link rel="icon" type="image/png" href="/favicon.png">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Defendia Network Defense | Görevler</title>
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/animations.css">
  <link rel="stylesheet" href="/css/notifications.css">
  <script src="/js/notifications.js"></script>
  <link rel="stylesheet" href="/css/dashboard.css">
  <script>window.__searchData = <%- JSON.stringify(searchData) %>;</script>
  <style>
    .ctf-layout { display:flex; flex:1; overflow:hidden; }
    .ctf-main { flex:1; overflow-y:auto; padding:20px; min-width:0; }
    .ctf-side { width:300px; min-width:300px; border-left:1px solid rgba(255,255,255,0.06); padding:16px; overflow-y:auto; display:flex; flex-direction:column; gap:14px; }
    .ctf-page-head { display:flex; align-items:flex-end; justify-content:space-between; gap:18px; margin-bottom:16px; }
    .ctf-kicker { font-size:9px; font-weight:800; color:#475569; letter-spacing:2.4px; font-family:'JetBrains Mono',monospace; text-transform:uppercase; margin-bottom:6px; }
    .ctf-heading { font-size:24px; line-height:1.1; font-weight:900; color:#f8fafc; font-family:'JetBrains Mono',monospace; letter-spacing:1px; }
    .ctf-head-meta { font-size:10px; color:#64748b; font-family:'JetBrains Mono',monospace; white-space:nowrap; }
    .ctf-summary-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:10px; margin-bottom:16px; }
    .ctf-summary-card { min-height:68px; background:rgba(17,24,39,0.72); border:1px solid rgba(255,255,255,0.06); border-radius:8px; padding:13px 14px; display:flex; flex-direction:column; justify-content:center; }
    .ctf-summary-value { font-size:18px; line-height:1; font-weight:900; color:#f8fafc; font-family:'JetBrains Mono',monospace; }
    .ctf-summary-label { margin-top:7px; font-size:8px; font-weight:800; color:#475569; letter-spacing:1.5px; font-family:'JetBrains Mono',monospace; white-space:nowrap; }
    .ctf-filter-bar { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:20px; padding:10px; background:rgba(17,24,39,0.48); border:1px solid rgba(255,255,255,0.05); border-radius:10px; }
    .filter-pill { padding:7px 12px; border-radius:6px; border:1px solid rgba(255,255,255,0.08); background:rgba(255,255,255,0.02); color:#64748b; font-size:10px; font-weight:800; cursor:pointer; transition:all 0.2s; font-family:'JetBrains Mono',monospace; letter-spacing:1px; }
    .filter-pill:hover { color:#cbd5e1; border-color:rgba(255,255,255,0.18); background:rgba(255,255,255,0.04); }
    .filter-pill.active { color:#38bdf8; border-color:rgba(56,189,248,0.5); background:rgba(56,189,248,0.08); box-shadow:0 0 12px rgba(56,189,248,0.08); }
    .category-section { margin-bottom:28px; }
    .cat-header { display:flex; align-items:center; gap:12px; margin-bottom:12px; }
    .cat-title { font-size:11px; font-weight:900; color:#38bdf8; font-family:'JetBrains Mono',monospace; letter-spacing:2px; text-transform:uppercase; white-space:nowrap; }
    .cat-line { flex:1; height:1px; background:linear-gradient(90deg,rgba(56,189,248,0.2),rgba(255,255,255,0.04)); }
    .cat-count { font-size:10px; color:#475569; font-family:'JetBrains Mono',monospace; white-space:nowrap; }
    .ctf-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(285px,1fr)); gap:12px; }
    .ctf-card { background:rgba(17,24,39,0.72); border:1px solid rgba(255,255,255,0.06); border-radius:8px; padding:15px; position:relative; display:flex; flex-direction:column; min-height:176px; transition:border-color 0.2s, transform 0.2s, box-shadow 0.2s, background 0.2s; }
    .ctf-card:hover { border-color:rgba(56,189,248,0.36); transform:translateY(-2px); background:rgba(17,24,39,0.86); box-shadow:0 12px 28px rgba(0,0,0,0.24); }
    .ctf-card.solved { border-color:rgba(16,185,129,0.26); background:rgba(16,185,129,0.045); }
    .ctf-card-top { display:flex; align-items:center; gap:7px; margin-bottom:10px; padding-right:0; }
    .ctf-card.solved .ctf-card-top { padding-right:86px; }
    .diff-badge { font-size:8px; font-weight:900; padding:3px 7px; border-radius:4px; font-family:'JetBrains Mono',monospace; letter-spacing:1px; border:1px solid; white-space:nowrap; }
    .ctf-pts { font-size:10px; color:#64748b; font-family:'JetBrains Mono',monospace; margin-left:auto; white-space:nowrap; flex-shrink:0; }
    .solved-stamp { position:absolute; top:12px; right:12px; background:rgba(16,185,129,0.12); border:1px solid rgba(16,185,129,0.45); color:#10b981; font-size:8px; font-weight:900; padding:3px 7px; border-radius:4px; font-family:'JetBrains Mono',monospace; letter-spacing:1px; z-index:1; }
    .ctf-title { font-size:14px; font-weight:800; color:#f8fafc; margin-bottom:7px; line-height:1.25; }
    .ctf-hint { font-size:11px; color:#64748b; line-height:1.5; flex:1; margin-bottom:0; display:-webkit-box; -webkit-line-clamp:4; -webkit-box-orient:vertical; overflow:hidden; }
    .ctf-card-footer { display:flex; align-items:center; justify-content:space-between; gap:8px; margin-top:12px; min-height:30px; }
    .download-link { display:inline-flex; align-items:center; gap:5px; font-size:10px; color:#38bdf8; font-family:'JetBrains Mono',monospace; text-decoration:none; white-space:nowrap; }
    .download-link:hover { color:#7dd3fc; }
    .flag-row { display:flex; gap:6px; margin-top:12px; }
    .flag-input { flex:1; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.09); border-radius:6px; padding:8px 10px; font-size:11px; color:#cbd5e1; font-family:'JetBrains Mono',monospace; outline:none; min-width:0; }
    .flag-input:focus { border-color:rgba(56,189,248,0.45); background:rgba(56,189,248,0.04); }
    .submit-btn { padding:8px 12px; background:#10b981; border:none; border-radius:6px; color:#07111f; font-size:10px; font-weight:900; cursor:pointer; white-space:nowrap; flex-shrink:0; font-family:'JetBrains Mono',monospace; letter-spacing:.7px; }
    .submit-btn:hover { background:#34d399; }
    .solved-row { display:flex; align-items:center; gap:6px; font-size:10px; color:#10b981; font-family:'JetBrains Mono',monospace; font-weight:800; margin-top:12px; }
    .ctf-side-card { background:rgba(17,24,39,0.76); border:1px solid rgba(255,255,255,0.06); border-radius:10px; padding:15px; backdrop-filter:blur(6px); }
    .ctf-side-title { display:flex; align-items:center; justify-content:space-between; gap:10px; font-size:9px; font-weight:900; color:#475569; letter-spacing:2px; font-family:'JetBrains Mono',monospace; text-transform:uppercase; margin-bottom:12px; }
    .ctf-progress-big { display:flex; align-items:flex-end; justify-content:space-between; gap:12px; }
    .ctf-progress-num { font-size:34px; font-weight:900; color:#38bdf8; font-family:'JetBrains Mono',monospace; line-height:1; text-shadow:0 0 14px rgba(56,189,248,0.35); }
    .ctf-progress-sub { font-size:9px; color:#64748b; font-family:'JetBrains Mono',monospace; text-align:right; line-height:1.5; }
    .ctf-progress-bar { height:5px; background:rgba(255,255,255,0.05); border-radius:5px; overflow:hidden; margin:12px 0 8px; }
    .ctf-progress-fill { height:100%; background:linear-gradient(90deg,#10b981,#38bdf8); border-radius:5px; box-shadow:0 0 8px rgba(56,189,248,0.35); }
    .ctf-side-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
    .ctf-side-metric { background:rgba(255,255,255,0.025); border:1px solid rgba(255,255,255,0.045); border-radius:8px; padding:10px; }
    .ctf-side-metric strong { display:block; font-size:14px; color:#f8fafc; font-family:'JetBrains Mono',monospace; line-height:1; }
    .ctf-side-metric span { display:block; margin-top:6px; font-size:8px; color:#475569; font-weight:800; letter-spacing:1px; font-family:'JetBrains Mono',monospace; }
    .ctf-list-row { display:flex; align-items:center; gap:9px; padding:9px 0; border-bottom:1px solid rgba(255,255,255,0.04); text-decoration:none; color:inherit; }
    .ctf-list-row:last-child { border-bottom:none; padding-bottom:0; }
    .ctf-list-dot { width:7px; height:7px; border-radius:50%; background:#38bdf8; box-shadow:0 0 8px rgba(56,189,248,0.45); flex-shrink:0; }
    .ctf-list-dot.done { background:#10b981; box-shadow:0 0 8px rgba(16,185,129,0.45); }
    .ctf-list-main { flex:1; min-width:0; }
    .ctf-list-title { display:block; font-size:11px; font-weight:800; color:#94a3b8; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .ctf-list-sub { display:block; margin-top:3px; font-size:9px; color:#475569; font-family:'JetBrains Mono',monospace; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .ctf-list-score { font-size:10px; font-weight:900; color:#38bdf8; font-family:'JetBrains Mono',monospace; flex-shrink:0; }
    .ctf-break-row { margin-bottom:11px; }
    .ctf-break-head { display:flex; justify-content:space-between; gap:10px; margin-bottom:5px; font-size:10px; font-weight:800; color:#64748b; font-family:'JetBrains Mono',monospace; }
    .ctf-break-bar { height:4px; background:rgba(255,255,255,0.05); border-radius:4px; overflow:hidden; }
    .ctf-break-fill { height:100%; border-radius:4px; background:#38bdf8; }
    .ctf-empty { padding:10px 0 2px; text-align:center; font-size:11px; color:#334155; font-family:'JetBrains Mono',monospace; }
    .toast-fixed { position:fixed; bottom:24px; left:50%; transform:translateX(-50%) translateY(100px); background:#111827; color:white; padding:12px 24px; border-radius:8px; font-weight:700; font-size:13px; z-index:9999; transition:transform 0.3s; pointer-events:none; border-left:3px solid #38bdf8; }
    @media (max-width:1180px) { .ctf-layout { flex-direction:column; overflow-y:auto; } .ctf-main { overflow:visible; } .ctf-side { width:auto; min-width:0; border-left:none; border-top:1px solid rgba(255,255,255,0.06); display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); } }
    @media (max-width:820px) { .ctf-page-head { align-items:flex-start; flex-direction:column; } .ctf-summary-grid, .ctf-side { grid-template-columns:1fr; } .ctf-grid { grid-template-columns:1fr; } }
  </style>
</head>
<body>
<%
  const categories = [...new Set(Object.values(challenges).map(t => t.category))];
  const totalChallenges = Object.keys(challenges).length;
  const solvedList = user.solved || [];
  const totalSolved = Object.values(challenges).filter(c => solvedList.includes(c.id)).length;
  const overallProgress = totalChallenges === 0 ? 0 : Math.round((totalSolved / totalChallenges) * 100);
  let catStats = {};
  categories.forEach(cat => catStats[cat] = { total:0, solved:0 });
  Object.values(challenges).forEach(c => {
    if(catStats[c.category]) {
      catStats[c.category].total++;
      if(solvedList.includes(c.id)) catStats[c.category].solved++;
    }
  });
%>

<div id="toast" class="toast-fixed"></div>

<div class="dash-shell">
  <%- include('partials/sidebar-only') %>

  <div class="dash-main">
    <!-- Topbar -->
    <div class="dash-topbar">
      <div class="dash-topbar-left">
        <div class="dash-status-tag">GÖREVLER // <span>CTF_MİSYONLARI</span></div>
      </div>
      <%- include('partials/topbar-actions') %>
    </div>

    <!-- İçerik + Sağ Panel -->
    <div class="ctf-layout">

      <!-- Sol: Görevler -->
      <div class="ctf-main page-enter">
        <div class="ctf-page-head">
          <div>
            <div class="ctf-kicker">CTF_GÖREVLERİ // OPERASYON LİSTESİ</div>
            <div class="ctf-heading">Bayrak Görevleri</div>
          </div>
          <div class="ctf-head-meta"><%= totalChallenges %> görev · <%= ctfData.downloadableCount %> dosyalı · <%= ctfData.remainingPoints %> puan kaldı</div>
        </div>

        <div class="ctf-summary-grid">
          <div class="ctf-summary-card">
            <div class="ctf-summary-value"><%= overallProgress %>%</div>
            <div class="ctf-summary-label">GENEL İLERLEME</div>
          </div>
          <div class="ctf-summary-card">
            <div class="ctf-summary-value"><%= totalSolved %>/<%= totalChallenges %></div>
            <div class="ctf-summary-label">ÇÖZÜLEN GÖREV</div>
          </div>
          <div class="ctf-summary-card">
            <div class="ctf-summary-value"><%= ctfData.solvedPoints %></div>
            <div class="ctf-summary-label">TOPLANAN PUAN</div>
          </div>
          <div class="ctf-summary-card">
            <div class="ctf-summary-value"><%= categories.length %></div>
            <div class="ctf-summary-label">KATEGORİ</div>
          </div>
        </div>

        <!-- Filtreler -->
        <div class="ctf-filter-bar">
          <button class="filter-pill active" onclick="filterCategory('all',this)">Tümü</button>
          <% categories.forEach(cat => { %>
            <button class="filter-pill" onclick="filterCategory('<%= cat %>',this)"><%= cat %></button>
          <% }) %>
        </div>

        <!-- Kategori Grupları -->
        <div id="challenges-container">
          <% categories.forEach(cat => { %>
          <div class="category-section" data-category="<%= cat %>" style="margin-bottom:28px;">
            <div class="cat-header">
              <span class="cat-title"><%= cat %></span>
              <div class="cat-line"></div>
              <span class="cat-count"><%= catStats[cat].solved %>/<%= catStats[cat].total %></span>
            </div>

            <div class="ctf-grid">
              <% Object.values(challenges).filter(t => t.category === cat).forEach((task, index) => {
                const isSolved = solvedList.includes(task.id);
                const diff = task.points <= 75 ? 'Kolay' : (task.points <= 150 ? 'Orta' : 'Zor');
                const dc = { Kolay:'#10b981', Orta:'#fbbf24', Zor:'#ef4444' }[diff];
              %>
              <div class="ctf-card <%= isSolved?'solved':'' %> fade-in-up stagger-<%= (index%5)+1 %>">
                <% if(isSolved) { %><div class="solved-stamp">TAMAMLANDI</div><% } %>

                <div class="ctf-card-top">
                  <span class="diff-badge" style="color:<%= dc %>;border-color:<%= dc %>;"><%= diff.toUpperCase() %></span>
                  <span class="ctf-pts"><%= task.points %> PUAN</span>
                </div>

                <div class="ctf-title"><%= task.title %></div>
                <div class="ctf-hint"><%= task.hint %></div>

                <% if(task.download) { %>
                  <a href="<%= task.download %>" download class="download-link" style="margin-top:10px;">
                    <span class="material-icons" style="font-size:12px;">download</span>DOSYA İNDİR
                  </a>
                <% } %>

                <% if(!isSolved) { %>
                  <div class="flag-row">
                    <input type="text" id="flagInput-<%= task.id %>" class="flag-input" placeholder="bluenetwork{...}" onkeydown="if(event.key==='Enter')submitFlag('<%= task.id %>')">
                    <button onclick="submitFlag('<%= task.id %>')" class="submit-btn">GÖNDER</button>
                  </div>
                <% } else { %>
                  <div class="solved-row">
                    <span class="material-icons" style="font-size:14px;">check_circle</span>BAYRAK ELE GEÇİRİLDİ
                  </div>
                <% } %>
              </div>
              <% }) %>
            </div>
          </div>
          <% }) %>
        </div>
      </div>

      <!-- Sağ Sidebar -->
      <div class="ctf-side">

        <!-- Genel İlerleme -->
        <div class="ctf-side-card">
          <div class="ctf-side-title">
            <span>GENEL İLERLEME</span>
            <span class="material-icons" style="font-size:14px;color:#38bdf8;">query_stats</span>
          </div>
          <div class="ctf-progress-big">
            <div class="ctf-progress-num"><%= overallProgress %>%</div>
            <div class="ctf-progress-sub">
              <%= totalSolved %>/<%= totalChallenges %> görev<br>
              <%= ctfData.solvedPoints %>/<%= ctfData.totalPoints %> puan
            </div>
          </div>
          <div class="ctf-progress-bar">
            <div class="ctf-progress-fill" style="width:<%= overallProgress %>%;"></div>
          </div>
          <div class="ctf-side-grid">
            <div class="ctf-side-metric"><strong><%= ctfData.remainingPoints %></strong><span>KALAN PUAN</span></div>
            <div class="ctf-side-metric"><strong><%= ctfData.downloadableCount %></strong><span>DOSYALI</span></div>
          </div>
        </div>

        <!-- Sıradaki hedefler -->
        <div class="ctf-side-card">
          <div class="ctf-side-title">
            <span>SIRADAKİ HEDEFLER</span>
            <span class="material-icons" style="font-size:14px;color:#38bdf8;">flag</span>
          </div>
          <% if(ctfData.nextTargets.length === 0) { %>
            <div class="ctf-empty">Tüm CTF görevleri tamamlandı</div>
          <% } else { %>
            <% ctfData.nextTargets.forEach(item => { %>
              <div class="ctf-list-row">
                <span class="ctf-list-dot"></span>
                <span class="ctf-list-main">
                  <span class="ctf-list-title"><%= item.title %></span>
                  <span class="ctf-list-sub"><%= item.category %> · <%= item.difficulty %><%= item.hasDownload ? ' · dosyalı' : '' %></span>
                </span>
                <span class="ctf-list-score"><%= item.points %>p</span>
              </div>
            <% }) %>
          <% } %>
        </div>

        <!-- Son çözümler -->
        <div class="ctf-side-card">
          <div class="ctf-side-title">
            <span>SON ÇÖZÜMLER</span>
            <span class="material-icons" style="font-size:14px;color:#10b981;">history</span>
          </div>
          <% if(ctfData.recentSolves.length === 0) { %>
            <div class="ctf-empty">Henüz CTF çözüm kaydı yok</div>
          <% } else { %>
            <% ctfData.recentSolves.forEach(item => {
              const solvedDate = new Date(item.solvedAt);
            %>
              <div class="ctf-list-row">
                <span class="ctf-list-dot done"></span>
                <span class="ctf-list-main">
                  <span class="ctf-list-title"><%= item.title %></span>
                  <span class="ctf-list-sub"><%= item.category %> · <%= solvedDate.toLocaleDateString('tr-TR', { day:'2-digit', month:'2-digit' }) %> <%= solvedDate.toLocaleTimeString('tr-TR', { hour:'2-digit', minute:'2-digit' }) %></span>
                </span>
                <span class="ctf-list-score">+<%= item.points %></span>
              </div>
            <% }) %>
          <% } %>
        </div>

        <!-- Kategori İstatistikleri -->
        <div class="ctf-side-card">
          <div class="ctf-side-title">
            <span>KATEGORİLER</span>
            <span class="material-icons" style="font-size:14px;color:#a78bfa;">category</span>
          </div>
          <% Object.keys(catStats).forEach(cat => {
            const pct = catStats[cat].total===0 ? 0 : Math.round((catStats[cat].solved/catStats[cat].total)*100);
            const c = pct===100?'#10b981':(pct>0?'#38bdf8':'#1e293b');
          %>
            <div class="ctf-break-row">
              <div class="ctf-break-head">
                <span><%= cat %></span>
                <span><%= catStats[cat].solved %>/<%= catStats[cat].total %></span>
              </div>
              <div class="ctf-break-bar"><div class="ctf-break-fill" style="background:<%= c %>;width:<%= pct %>%;"></div></div>
            </div>
          <% }) %>
        </div>

        <!-- Zorluk Kırılımı -->
        <div class="ctf-side-card">
          <div class="ctf-side-title">
            <span>ZORLUK</span>
            <span class="material-icons" style="font-size:14px;color:#fbbf24;">stacked_bar_chart</span>
          </div>
          <% ctfData.difficultyStats.forEach(diff => {
            const pct = diff.total ? Math.round((diff.solved / diff.total) * 100) : 0;
            const c = diff.label === 'Kolay' ? '#10b981' : (diff.label === 'Orta' ? '#fbbf24' : '#ef4444');
          %>
            <div class="ctf-break-row">
              <div class="ctf-break-head">
                <span><%= diff.label %></span>
                <span><%= diff.solved %>/<%= diff.total %> · <%= diff.points %>p</span>
              </div>
              <div class="ctf-break-bar"><div class="ctf-break-fill" style="background:<%= c %>;width:<%= pct %>%;"></div></div>
            </div>
          <% }) %>
        </div>

        <!-- En İyi Operatörler — madalyalı -->
        <div class="ctf-side-card">
          <div class="ctf-side-title">
            <span>EN İYİ OPERATÖRLER</span>
            <span class="material-icons" style="font-size:14px;color:#fbbf24;">leaderboard</span>
          </div>
          <div id="leaderList" style="display:flex;flex-direction:column;gap:8px;">
            <div style="font-size:11px;color:#475569;font-family:'JetBrains Mono',monospace;">Yükleniyor...</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function filterCategory(cat, btn) {
  document.querySelectorAll('.filter-pill').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('.category-section').forEach(s => {
    s.style.display = (cat==='all' || s.dataset.category===cat) ? 'block' : 'none';
  });
}

function showToast(msg, color) {
  const t = document.getElementById('toast');
  t.textContent = msg; t.style.borderLeftColor = color;
  t.style.transform = 'translateX(-50%) translateY(0)';
  setTimeout(() => t.style.transform = 'translateX(-50%) translateY(100px)', 3500);
}

async function submitFlag(id) {
  const flag = document.getElementById('flagInput-'+id).value;
  if(!flag) return showToast('Flag boş bırakılamaz!', '#ef4444');
  const data = await (await fetch('/api/submit-flag', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({labId:id, flag})
  })).json();
  if(data.success) { showToast(data.message, '#10b981'); setTimeout(() => location.reload(), 1500); }
  else showToast(data.message, '#ef4444');
}

async function loadLeaderboard() {
  try {
    const data = await (await fetch('/api/leaderboard')).json();
    const medals = ['🥇','🥈','🥉'];
    const mColors = ['#fbbf24','#94a3b8','#b45309'];
    document.getElementById('leaderList').innerHTML = data.slice(0,5).map((u,i) => {
      const isMe = u.username === '<%= user.username %>';
      const medal = medals[i] || null;
      const av = u.avatar
        ? `<a href="/profile/${u.username}"><img src="${u.avatar}" style="width:28px;height:28px;border-radius:50%;object-fit:cover;border:1.5px solid ${medal?mColors[i]:'rgba(255,255,255,0.1)'};flex-shrink:0;cursor:pointer;transition:transform 0.2s;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'"></a>`
        : `<a href="/profile/${u.username}" style="text-decoration:none;"><div style="width:28px;height:28px;border-radius:50%;background:#334155;border:1.5px solid ${medal?mColors[i]:'rgba(255,255,255,0.1)'};display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:white;flex-shrink:0;">${u.username[0].toUpperCase()}</div></a>`;
      return `<div style="display:flex;align-items:center;gap:8px;padding:6px 8px;border-radius:8px;background:${isMe?'rgba(56,189,248,0.06)':'rgba(255,255,255,0.02)'};border:1px solid ${isMe?'rgba(56,189,248,0.2)':'rgba(255,255,255,0.04)'};">
        <span style="font-size:${medal?'16px':'11px'};width:20px;text-align:center;flex-shrink:0;color:${medal?mColors[i]:'#475569'};font-family:'JetBrains Mono',monospace;">${medal||i+1}</span>
        ${av}
        <a href="/profile/${u.username}" style="flex:1;font-size:12px;font-weight:600;color:${isMe?'#38bdf8':'#cbd5e1'};text-decoration:none;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${u.username}${isMe?' (Sen)':''}</a>
        <span style="font-size:10px;font-weight:700;color:${medal?mColors[i]:'#475569'};font-family:'JetBrains Mono',monospace;flex-shrink:0;">${u.points}</span>
      </div>`;
    }).join('');
  } catch(e) {}
}
loadLeaderboard();

document.addEventListener('DOMContentLoaded', () => {
  const bell = document.getElementById('notifBellBtn');
  const drop = document.getElementById('notifDropdown');
  if(bell && drop) {
    loadNotificationData();
    bell.addEventListener('click', e => { e.stopPropagation(); const o = drop.classList.toggle('active'); if(o) markAllAsRead(); });
    document.addEventListener('click', e => { if(!bell.contains(e.target)&&!drop.contains(e.target)) drop.classList.remove('active'); });
    document.getElementById('notifClearBtn').addEventListener('click', clearAllNotifications);
  }
  let es=null, r=0;
  function conn() {
    if(es) es.close();
    es = new EventSource('/api/notifications/stream');
    es.onmessage = e => { try { processNotification(JSON.parse(e.data)); } catch(err) {} };
    es.onerror = () => { es.close(); if(r++<3) setTimeout(conn, 5000); };
    es.addEventListener('ping', () => { r=0; });
  }
  conn();
});

/* ── Bildirim Yardımcı Fonksiyonları ── */
function loadNotificationData() {
  var c = parseInt(localStorage.getItem('notif_unread_count')||'0');
  var h = JSON.parse(localStorage.getItem('notif_history')||'[]');
  var b = document.getElementById('notifBadge');
  if(b){b.textContent=c;b.classList.toggle('hidden',c===0);}
  var l = document.getElementById('notifList');
  if(!l) return;
  if(!h.length){l.innerHTML='<div class="notif-empty">Henüz bildirim yok</div>';return;}
  var cols={info:'#38bdf8',success:'#10b981',warning:'#fbbf24',danger:'#ef4444'};
  l.innerHTML=h.slice(-10).reverse().map(function(n){return '<div class="notif-item" style="border-left-color:'+(cols[n.severity]||cols.info)+'"><div class="notif-item-message">'+n.message+'</div></div>';}).join('');
}
function markAllAsRead(){localStorage.setItem('notif_unread_count','0');var b=document.getElementById('notifBadge');if(b){b.textContent='0';b.classList.add('hidden');}}
function clearAllNotifications(){localStorage.setItem('notif_history','[]');localStorage.setItem('notif_unread_count','0');var b=document.getElementById('notifBadge');if(b){b.textContent='0';b.classList.add('hidden');}var l=document.getElementById('notifList');if(l)l.innerHTML='<div class="notif-empty">Henüz bildirim yok</div>';var d=document.getElementById('notifDropdown');if(d)d.classList.remove('active');}
function handleNotification(notif){if(notif.sound!==false&&typeof _playSound==='function')_playSound('notif');if(typeof showCriticalModal==='function')showCriticalModal(notif);var h=JSON.parse(localStorage.getItem('notif_history')||'[]');h.push(notif);var l=h.slice(-10);localStorage.setItem('notif_history',JSON.stringify(l));var b=document.getElementById('notifBadge');var n=parseInt(localStorage.getItem('notif_unread_count')||'0')+1;localStorage.setItem('notif_unread_count',n.toString());if(b){b.textContent=n;b.classList.remove('hidden');}}
</script>
</body>
</html>
